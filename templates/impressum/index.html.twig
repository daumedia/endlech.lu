{% extends 'base.html.twig' %}

{% block title %}{{ 'legal.title'|trans }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12 max-w-2xl">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">{{ 'legal.heading'|trans }}</h1>

    <section class="mb-8">
        <h2 class="text-xl font-semibold text-gray-800 mb-3">{{ 'legal.info_title'|trans }}</h2>
        <p class="text-gray-700 leading-relaxed">
            {{ 'legal.info_text'|trans|nl2br }}
        </p>
    </section>

    <section class="mb-8">
        <h2 class="text-xl font-semibold text-gray-800 mb-3">{{ 'legal.contact_title'|trans }}</h2>
        <p class="text-gray-700 leading-relaxed">
            {{ 'legal.contact_email_label'|trans }} <a href="mailto:info@endlech.lu" class="text-cyan-600 hover:underline">info@endlech.lu</a>
        </p>
    </section>

    <section class="mb-8">
        <h2 class="text-xl font-semibold text-gray-800 mb-3">{{ 'legal.disclaimer_title'|trans }}</h2>
        <h3 class="text-base font-semibold text-gray-700 mb-2">{{ 'legal.content_title'|trans }}</h3>
        <p class="text-gray-600 leading-relaxed mb-4">
            {{ 'legal.content_text'|trans }}
        </p>
        <h3 class="text-base font-semibold text-gray-700 mb-2">{{ 'legal.links_title'|trans }}</h3>
        <p class="text-gray-600 leading-relaxed">
            {{ 'legal.links_text'|trans }}
        </p>
    </section>

    <section id="datenschutz" class="mb-8 scroll-mt-24">
        <h2 class="text-xl font-semibold text-gray-800 mb-3">{{ 'legal.privacy_title'|trans }}</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
            {{ 'legal.privacy_text'|trans }}
        </p>
        {# ⚠ BF-65: Die Erklärung nannte einen von drei Empfängern. Sentry war
           beschrieben, Brevo und der Verkéiersverbond nicht — dabei empfängt
           Brevo JEDE E-Mail-Adresse, die das Projekt speichert. Art. 13 Abs. 1
           lit. e DSGVO verlangt die Nennung der Empfänger.

           Die Betroffenenrechte stehen jetzt hier, weil es sie jetzt gibt
           (Feature 01). Vorher wäre ein Text, der sie nennt, schlechter gewesen
           als einer, der schweigt. #}
        <h3 class="text-base font-semibold text-gray-700 mb-2">{{ 'legal.error_tracking_title'|trans }}</h3>
        <p class="text-gray-600 leading-relaxed mb-4">
            {{ 'legal.error_tracking_text'|trans }}
        </p>

        <h3 class="text-base font-semibold text-gray-700 mb-2">{{ 'legal.mail_title'|trans }}</h3>
        <p class="text-gray-600 leading-relaxed mb-4">
            {{ 'legal.mail_text'|trans }}
        </p>

        <h3 class="text-base font-semibold text-gray-700 mb-2">{{ 'legal.transit_title'|trans }}</h3>
        <p class="text-gray-600 leading-relaxed mb-4">
            {{ 'legal.transit_text'|trans }}
        </p>

        <h3 class="text-base font-semibold text-gray-700 mb-2">{{ 'legal.rights_title'|trans }}</h3>
        <p class="text-gray-600 leading-relaxed mb-3">
            {{ 'legal.rights_intro'|trans }}
        </p>
        <ul class="text-gray-600 leading-relaxed mb-4 list-disc pl-5 space-y-1">
            <li>{{ 'legal.rights_access'|trans }}</li>
            <li>{{ 'legal.rights_erasure'|trans }}</li>
            <li>{{ 'legal.rights_portability'|trans }}</li>
            <li>{{ 'legal.rights_withdraw'|trans }}</li>
            <li>{{ 'legal.rights_complaint'|trans }}</li>
        </ul>
        <p class="text-gray-600 leading-relaxed mb-4">
            {{ 'legal.rights_how'|trans }}
            <a href="{{ path('app_profile') }}" class="text-cyan-700 hover:underline">{{ 'legal.rights_profile_link'|trans }}</a>.
        </p>

        <h3 class="text-base font-semibold text-gray-700 mb-2">{{ 'legal.retention_title'|trans }}</h3>
        <p class="text-gray-600 leading-relaxed">
            {{ 'legal.retention_text'|trans }}
        </p>
    </section>
</div>
{% endblock %}
