{#
    Newsletter im Profil (Feature 12, AK-34 bis AK-38; löst 04/OF-02).

    ⚠ Eigenes Formular, außerhalb des Profilformulars — `<form>` im `<form>` verwirft der Browser.
    ⚠ Die Richtung steht im Knopf (`action`), nicht im Zustand des Servers: zwei offene Tabs
    drehen sich so nicht gegenseitig um (EC-08).
    ⚠ Der Schalter löst KEIN Messereignis aus — „Verwaltung und Profil werden nicht gemessen"
    steht auf /legal (AK-52).
#}
{% set abonniert = app.user.marketingConsentAt is not null %}
<section class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8" aria-labelledby="newsletter-titel">
    <h2 id="newsletter-titel" class="text-lg font-bold text-gray-900 mb-2">{{ 'newsletter.title'|trans }}</h2>
    {# BF-174: Für ein unbestätigtes Konto gilt Abbestellen nur für dieses Konto (BF-155) — der Text sagt es. #}
    <p class="text-sm text-gray-700 mb-4">{{ (app.user.verified ? 'newsletter.text' : 'newsletter.text_unverified')|trans }}</p>

    <p class="font-semibold text-gray-900">
        {%- if abonniert -%}
            {{ 'newsletter.subscribed_since'|trans({'%date%': app.user.marketingConsentAt|date('d.m.Y')}) }}
        {%- else -%}
            {{ 'newsletter.not_subscribed'|trans }}
        {%- endif -%}
    </p>
    {% if abonniert and not app.user.verified %}
        <p class="mt-1 text-sm text-amber-800">{{ 'newsletter.pending_verification'|trans }}</p>
    {% endif %}

    <form method="post" action="{{ path('app_profile_newsletter') }}" class="mt-4">
        <input type="hidden" name="_token" value="{{ csrf_token('profile-newsletter') }}">
        <input type="hidden" name="action" value="{{ abonniert ? 'unsubscribe' : 'subscribe' }}">
        <button type="submit" class="inline-flex items-center justify-center min-h-[44px] rounded-full border-2 border-purple-600 px-5 py-2 text-sm font-bold text-purple-700 hover:bg-purple-50 motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
            {{ (abonniert ? 'newsletter.unsubscribe' : 'newsletter.subscribe')|trans }}
        </button>
    </form>

    {% if app.user.verified %}
        <p class="mt-6 pt-4 border-t border-gray-100">
            {# BF-158: kein Vorabladen beim Überfahren — sonst zählte Turbo die Einführung als
               angezeigt, und beim Klick käme die vorab geholte Antwort, nicht eine echte Anzeige. #}
            <a href="{{ path('app_onboarding') }}" data-turbo-prefetch="false" class="inline-flex items-center min-h-[44px] text-sm font-semibold text-purple-700 hover:text-purple-900 underline underline-offset-4 focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">{{ 'onboarding.profile_link'|trans }}</a>
        </p>
    {% endif %}
</section>
