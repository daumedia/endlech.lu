{% extends 'base.html.twig' %}

{% block title %}{{ 'restaurant.list.title'|trans }}{% endblock %}

{% block body %}

    <div class="min-h-screen bg-gray-50">
        {# --- HERO SECTION --- #}
        <div class="bg-linear-to-r from-cyan-600 to-purple-700 text-white py-12 shadow-md">
            <div class="container mx-auto px-4">
                <h1 class="text-3xl font-bold mb-2">{{ 'restaurant.list.heading'|trans }}</h1>
                <p class="text-cyan-100 text-lg">{{ 'restaurant.list.subtitle'|trans({'%count%': total}) }}</p>
            </div>
        </div>

        {# --- MAIN LAYOUT MIT PANELS --- #}
        <div class="container mx-auto px-4 py-8">
            <div class="flex flex-col lg:flex-row gap-8">

                {# === LINKES PANEL: FILTER (Sidebar) === #}
                <aside class="w-full lg:w-1/4">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-24">
                        <div class="flex items-center gap-2 mb-6 text-purple-700">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
                            <h2 class="font-bold text-lg">{{ 'filter.title'|trans }}</h2>
                        </div>

                        <form method="get" action="{{ path('app_restaurant_index') }}"
                              {# Nutzungsmessung (Feature 11): nur die Namen gesetzter Filter, der Ort nur als Merker (AK-13). #}
                              data-controller="usage-event" data-action="submit->usage-event#filter"
                              data-usage-event-name-value="filter_angewandt">
                            <input type="hidden" name="sort" value="{{ sort }}">

                            <div class="mb-6">
                                <label class="block text-sm font-semibold text-gray-700 mb-2" for="filter-city">{{ 'filter.city'|trans }}</label>
                                <input type="text" id="filter-city" name="city" value="{{ filters.city }}" placeholder="{{ 'filter.city_placeholder'|trans }}" class="w-full bg-gray-50 border border-gray-500 rounded-lg px-4 py-2 text-sm motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
                            </div>

                            <div class="mb-6">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">{{ 'filter.cuisine'|trans }}</label>
                                <select name="cuisine[]" multiple aria-label="{{ 'filter.cuisine'|trans }}" data-controller="tom-select"
                                        placeholder="{{ 'filter.cuisine_placeholder'|trans }}">
                                    {% for cuisine in allCuisines %}
                                        <option value="{{ cuisine.id }}" {{ cuisine.id in filters.cuisine ? 'selected' : '' }}>{{ cuisine.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="mb-6">
                                <label class="block text-sm font-semibold text-gray-700 mb-3">{{ 'filter.status'|trans }}</label>
                                {# Feature 17, AK-39: nur für Angemeldete — ein Gast hat keine Favoriten.
                                   ⚠ `name` und `value` direkt hintereinander lassen: `UsageEventCatalogueTest`
                                   findet die Ja/Nein-Felder über genau dieses Muster (AK-66). #}
                                {% if app.user %}
                                    <label class="flex items-center gap-3 mb-2 cursor-pointer group">
                                        <input type="checkbox" name="favorites" value="1"
                                               class="rounded text-red-600 focus:ring-red-500 border-gray-300"
                                               {{ filters.favorites ? 'checked' : '' }}>
                                        <span class="text-sm text-gray-600 group-hover:text-red-700">❤️ {{ 'saved.filter.favorites'|trans }}</span>
                                    </label>
                                {% endif %}
                                <label class="flex items-center gap-3 mb-2 cursor-pointer group">
                                    <input type="checkbox" name="open" value="1"
                                           class="rounded text-green-600 focus:ring-green-500 border-gray-300"
                                           {{ filters.open ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-green-700">🟢 {{ 'filter.only_open'|trans }}</span>
                                </label>
                                <label class="flex items-center gap-3 cursor-pointer group">
                                    <input type="checkbox" name="verified" value="1"
                                           class="rounded text-cyan-600 focus:ring-cyan-500 border-gray-300"
                                           {{ filters.verified ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-cyan-700">✓ {{ 'filter.only_verified'|trans }}</span>
                                </label>
                            </div>

                            <div class="mb-6">
                                <label class="block text-sm font-semibold text-gray-700 mb-3">{{ 'filter.needs'|trans }}</label>

                                <label class="flex items-center gap-3 mb-2 cursor-pointer group">
                                    <input type="checkbox" name="wheelchair" value="1"
                                           class="rounded text-purple-600 focus:ring-purple-500 border-gray-300"
                                           {{ filters.wheelchair ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-purple-700">♿ {{ 'filter.wheelchair'|trans }}</span>
                                </label>

                                <label class="flex items-center gap-3 mb-2 cursor-pointer group">
                                    <input type="checkbox" name="toilet" value="1"
                                           class="rounded text-purple-600 focus:ring-purple-500 border-gray-300"
                                           {{ filters.toilet ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-purple-700">🚻 {{ 'filter.toilet'|trans }}</span>
                                </label>

                                <label class="flex items-center gap-3 mb-2 cursor-pointer group">
                                    <input type="checkbox" name="dogs" value="1"
                                           class="rounded text-purple-600 focus:ring-purple-500 border-gray-300"
                                           {{ filters.dogs ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-purple-700">🐕 {{ 'filter.dogs'|trans }}</span>
                                </label>

                                <label class="flex items-center gap-3 mb-2 cursor-pointer group">
                                    <input type="checkbox" name="lighting" value="1"
                                           class="rounded text-purple-600 focus:ring-purple-500 border-gray-300"
                                           {{ filters.lighting ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-purple-700">💡 {{ 'filter.lighting'|trans }}</span>
                                </label>

                                <label class="flex items-center gap-3 mb-2 cursor-pointer group">
                                    <input type="checkbox" name="changing_table" value="1"
                                           class="rounded text-purple-600 focus:ring-purple-500 border-gray-300"
                                           {{ filters.changing_table ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-purple-700">🍼 {{ 'filter.changing_table'|trans }}</span>
                                </label>

                                <label class="flex items-center gap-3 cursor-pointer group">
                                    <input type="checkbox" name="disabled_parking" value="1"
                                           class="rounded text-purple-600 focus:ring-purple-500 border-gray-300"
                                           {{ filters.disabled_parking ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-purple-700">🅿️ {{ 'filter.disabled_parking'|trans }}</span>
                                </label>
                            </div>

                            <div class="mb-6">
                                <label class="block text-sm font-semibold text-gray-700 mb-3">{{ 'filter.dietary'|trans }}</label>

                                <label class="flex items-center gap-3 mb-2 cursor-pointer group">
                                    <input type="checkbox" name="vegan" value="1"
                                           class="rounded text-emerald-600 focus:ring-emerald-500 border-gray-300"
                                           {{ filters.vegan ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-emerald-700">🌱 {{ 'filter.vegan'|trans }}</span>
                                </label>

                                <label class="flex items-center gap-3 mb-2 cursor-pointer group">
                                    <input type="checkbox" name="vegetarian" value="1"
                                           class="rounded text-emerald-600 focus:ring-emerald-500 border-gray-300"
                                           {{ filters.vegetarian ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-emerald-700">🥗 {{ 'filter.vegetarian'|trans }}</span>
                                </label>

                                <label class="flex items-center gap-3 cursor-pointer group">
                                    <input type="checkbox" name="halal" value="1"
                                           class="rounded text-emerald-600 focus:ring-emerald-500 border-gray-300"
                                           {{ filters.halal ? 'checked' : '' }}>
                                    <span class="text-sm text-gray-600 group-hover:text-emerald-700">☪️ {{ 'filter.halal'|trans }}</span>
                                </label>
                            </div>

                            <div class="mb-6">
                                <label class="block text-sm font-semibold text-gray-700 mb-3">{{ 'filter.languages'|trans }}</label>
                                {% for lang in languages %}
                                    <label class="flex items-center gap-3 mb-2 cursor-pointer group">
                                        <input type="checkbox" name="lang_{{ lang.value }}" value="1"
                                               class="rounded text-blue-600 focus:ring-blue-500 border-gray-300"
                                               {{ lang.value in filters.lang ? 'checked' : '' }}>
                                        <span class="text-sm text-gray-600 group-hover:text-blue-700">{{ lang.flag }} {{ lang.label }}</span>
                                    </label>
                                {% endfor %}
                            </div>

                            <button type="submit" class="w-full min-h-[48px] inline-flex items-center justify-center bg-gray-900 hover:bg-black text-white font-medium py-2 rounded-lg motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">
                                {{ 'filter.apply'|trans }}
                            </button>

                            {% set activeCount = (filters.favorites ? 1 : 0) + (filters.verified ? 1 : 0) + (filters.wheelchair ? 1 : 0) + (filters.toilet ? 1 : 0) + (filters.dogs ? 1 : 0) + (filters.lighting ? 1 : 0) + (filters.changing_table ? 1 : 0) + (filters.disabled_parking ? 1 : 0) + (filters.open ? 1 : 0) + (filters.vegan ? 1 : 0) + (filters.vegetarian ? 1 : 0) + (filters.halal ? 1 : 0) + (filters.city ? 1 : 0) + (filters.cuisine|length) + (filters.lang|length) %}
                            {% if activeCount > 0 %}
                                <a href="{{ path('app_restaurant_index', {sort: sort}) }}" class="block text-center text-xs text-red-600 hover:text-red-800 mt-3 py-1 rounded motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-red-600">
                                    × {{ 'filter.reset'|trans({'%count%': activeCount}) }}
                                </a>
                            {% endif %}
                        </form>
                    </div>
                </aside>

                {# === RECHTES PANEL: RESTAURANTS (Grid) === #}
                <main class="w-full lg:w-3/4">

                    {# Sortierung & Ergebnisanzahl #}
                    {% set filterParams = {
                        verified:       filters.verified       ? 1 : null,
                        wheelchair:     filters.wheelchair     ? 1 : null,
                        toilet:         filters.toilet         ? 1 : null,
                        dogs:           filters.dogs           ? 1 : null,
                        lighting:       filters.lighting       ? 1 : null,
                        changing_table:   filters.changing_table   ? 1 : null,
                        disabled_parking: filters.disabled_parking ? 1 : null,
                        open:             filters.open             ? 1 : null,
                        vegan:          filters.vegan          ? 1 : null,
                        vegetarian:     filters.vegetarian     ? 1 : null,
                        halal:          filters.halal          ? 1 : null,
                        city:           filters.city ?: null
                    } %}
                    {% for cuisineId in filters.cuisine %}
                        {% set filterParams = filterParams|merge({('cuisine[]'): cuisineId}) %}
                    {% endfor %}
                    {% for langVal in filters.lang %}
                        {% set filterParams = filterParams|merge({('lang_' ~ langVal): 1}) %}
                    {% endfor %}
                    {# Feature 17, AK-40: „Filter entfernen“ nimmt nur `favorites` (und die Seite) weg und
                       behält alles Übrige — deshalb erst hier, nach dieser Kopie, ergänzt. Sortierung und
                       Blättern führen den Filter mit (AK-38). #}
                    {% set paramsOhneFavoriten = filterParams %}
                    {% set filterParams = filterParams|merge({favorites: filters.favorites ? 1 : null}) %}
                    {# flex-wrap: bei 320px bricht die Sortier-Leiste unter die Überschrift,
                       statt die Seite waagerecht überlaufen zu lassen (BF-75, WCAG 1.4.10). #}
                    <div class="flex flex-wrap justify-between items-center gap-2 mb-4">
                        <h2 class="text-xl font-bold text-gray-800">{{ 'restaurant.list.results'|trans({'%count%': total}) }}</h2>
                        <div class="flex flex-wrap items-center gap-2">
                            <a href="{{ path('app_restaurant_index', {sort: 'rating', page: 1}|merge(filterParams)) }}"
                               class="px-3 py-1.5 text-sm rounded-lg border motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-purple-700 {{ sort == 'rating' ? 'bg-purple-600 text-white border-purple-600' : 'bg-white text-gray-700 border-gray-300 hover:border-purple-400' }}">
                                {{ 'restaurant.list.sort_rating'|trans }}
                            </a>
                            <a href="{{ path('app_restaurant_index', {sort: 'name', page: 1}|merge(filterParams)) }}"
                               class="px-3 py-1.5 text-sm rounded-lg border motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-purple-700 {{ sort == 'name' ? 'bg-purple-600 text-white border-purple-600' : 'bg-white text-gray-700 border-gray-300 hover:border-purple-400' }}">
                                {{ 'restaurant.list.sort_name'|trans }}
                            </a>
                            <a href="{{ path('app_restaurant_index', {sort: 'newest', page: 1}|merge(filterParams)) }}"
                               class="px-3 py-1.5 text-sm rounded-lg border motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-purple-700 {{ sort == 'newest' ? 'bg-purple-600 text-white border-purple-600' : 'bg-white text-gray-700 border-gray-300 hover:border-purple-400' }}">
                                {{ 'restaurant.list.sort_newest'|trans }}
                            </a>
                        </div>
                    </div>

                    {# Aktive Filter als Chips #}
                    {% if activeCount > 0 %}
                    <div class="flex flex-wrap gap-2 mb-4">
                        {% if filters.favorites %}<span class="inline-flex items-center text-xs bg-red-100 text-red-700 px-2 py-1 rounded-full border border-red-200">❤️ {{ 'saved.filter.favorites'|trans }}</span>{% endif %}
                        {% if filters.open %}<span class="inline-flex items-center text-xs bg-green-100 text-green-700 px-2 py-1 rounded-full border border-green-200">🟢 {{ 'chip.open'|trans }}</span>{% endif %}
                        {% if filters.verified %}<span class="inline-flex items-center text-xs bg-cyan-100 text-cyan-700 px-2 py-1 rounded-full border border-cyan-200">✓ {{ 'chip.verified'|trans }}</span>{% endif %}
                        {% if filters.wheelchair %}<span class="inline-flex items-center text-xs bg-purple-100 text-purple-700 px-2 py-1 rounded-full border border-purple-200">♿ {{ 'chip.wheelchair'|trans }}</span>{% endif %}
                        {% if filters.toilet %}<span class="inline-flex items-center text-xs bg-purple-100 text-purple-700 px-2 py-1 rounded-full border border-purple-200">🚻 {{ 'chip.toilet'|trans }}</span>{% endif %}
                        {% if filters.dogs %}<span class="inline-flex items-center text-xs bg-purple-100 text-purple-700 px-2 py-1 rounded-full border border-purple-200">🐕 {{ 'chip.dogs'|trans }}</span>{% endif %}
                        {% if filters.lighting %}<span class="inline-flex items-center text-xs bg-purple-100 text-purple-700 px-2 py-1 rounded-full border border-purple-200">💡 {{ 'chip.lighting'|trans }}</span>{% endif %}
                        {% if filters.changing_table %}<span class="inline-flex items-center text-xs bg-purple-100 text-purple-700 px-2 py-1 rounded-full border border-purple-200">🍼 {{ 'chip.changing_table'|trans }}</span>{% endif %}
                        {% if filters.disabled_parking %}<span class="inline-flex items-center text-xs bg-purple-100 text-purple-700 px-2 py-1 rounded-full border border-purple-200">🅿️ {{ 'chip.disabled_parking'|trans }}</span>{% endif %}
                        {% if filters.vegan %}<span class="inline-flex items-center text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded-full border border-emerald-200">🌱 {{ 'chip.vegan'|trans }}</span>{% endif %}
                        {% if filters.vegetarian %}<span class="inline-flex items-center text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded-full border border-emerald-200">🥗 {{ 'chip.vegetarian'|trans }}</span>{% endif %}
                        {% if filters.halal %}<span class="inline-flex items-center text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded-full border border-emerald-200">☪️ {{ 'chip.halal'|trans }}</span>{% endif %}
                        {% if filters.city %}<span class="inline-flex items-center text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded-full border border-gray-200">📍 {{ filters.city }}</span>{% endif %}
                        {% for cuisineId in filters.cuisine %}
                            {% for cuisine in allCuisines %}
                                {% if cuisine.id == cuisineId %}
                                    <span class="inline-flex items-center text-xs bg-orange-100 text-orange-700 px-2 py-1 rounded-full border border-orange-200">🍽️ {{ cuisine.name }}</span>
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                        {% for langVal in filters.lang %}
                            {% for lang in languages %}
                                {% if lang.value == langVal %}
                                    <span class="inline-flex items-center text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded-full border border-blue-200">{{ lang.flag }} {{ lang.label }}</span>
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                    </div>
                    {% endif %}

                    {# Restaurant-Karten #}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        {% for restaurant in restaurants %}
                            {# Feature 17: Karte als Partial (auch auf „Gespeichert“); Herz aus `savedPage`.
                               Keine Notiz in der Suche — die steht nur auf den eigenen Seiten. #}
                            {% include 'partials/_restaurant_card.html.twig' with {
                                restaurant: restaurant,
                                isFavorite: savedPage.isFavorite(restaurant.id),
                            } only %}
                        {% else %}
                            {% if filters.favorites and hasAnyFavorites is same as(false) %}
                                {# AK-40: Filter gesetzt, aber noch nichts gemerkt — ein anderer Text als
                                   „keine Treffer“, und ein Weg zurück, der die übrigen Filter behält. #}
                                <div class="col-span-2 text-center py-16 text-gray-600">
                                    <p class="text-5xl mb-4" aria-hidden="true">🤍</p>
                                    <p class="text-lg font-medium text-gray-600">{{ 'saved.filter.no_favorites'|trans }}</p>
                                    <a href="{{ path('app_restaurant_index', {sort: sort}|merge(paramsOhneFavoriten)) }}"
                                       class="inline-flex items-center justify-center min-h-[44px] mt-3 px-3 text-sm font-semibold text-purple-700 underline hover:text-purple-900 rounded focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
                                        {{ 'saved.filter.remove'|trans }}
                                    </a>
                                </div>
                            {% else %}
                                <div class="col-span-2 text-center py-16 text-gray-600">
                                    <p class="text-5xl mb-4" aria-hidden="true">🍽️</p>
                                    <p class="text-lg font-medium text-gray-600">{{ 'restaurant.list.no_results'|trans }}</p>
                                    <p class="text-sm mt-1">{{ 'restaurant.list.no_results_help'|trans }}</p>
                                </div>
                            {% endif %}
                        {% endfor %}

                    </div>

                    {# --- PAGINATION --- #}
                    {% if lastPage > 1 %}
                        <nav class="flex justify-center items-center gap-2 mt-10" aria-label="Seitennavigation">
                            {% if currentPage > 1 %}
                                <a href="{{ path('app_restaurant_index', {sort: sort, page: currentPage - 1}|merge(filterParams)) }}"
                                   class="px-4 py-2 rounded-lg border border-gray-300 bg-white text-gray-700 hover:border-purple-400 motion-safe:transition text-sm focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
                                    ← {{ 'pagination.previous'|trans }}
                                </a>
                            {% endif %}

                            {% for p in 1..lastPage %}
                                <a href="{{ path('app_restaurant_index', {sort: sort, page: p}|merge(filterParams)) }}"
                                   class="px-4 py-2 rounded-lg border text-sm motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-purple-700 {{ p == currentPage ? 'bg-purple-600 text-white border-purple-600 font-bold' : 'bg-white text-gray-700 border-gray-300 hover:border-purple-400' }}">
                                    {{ p }}
                                </a>
                            {% endfor %}

                            {% if currentPage < lastPage %}
                                <a href="{{ path('app_restaurant_index', {sort: sort, page: currentPage + 1}|merge(filterParams)) }}"
                                   class="px-4 py-2 rounded-lg border border-gray-300 bg-white text-gray-700 hover:border-purple-400 motion-safe:transition text-sm focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
                                    {{ 'pagination.next'|trans }} →
                                </a>
                            {% endif %}
                        </nav>
                        <p class="text-center text-sm text-gray-600 mt-3">{{ 'pagination.page_of'|trans({'%current%': currentPage, '%last%': lastPage}) }}</p>
                    {% endif %}

                </main>
            </div>
        </div>
    </div>

{% endblock %}
