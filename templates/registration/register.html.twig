{% extends 'base.html.twig' %}

{% block title %}{{ 'register.title'|trans }}{% endblock %}

{% block body %}
<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center py-12 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8">

            {# Titel #}
            <div class="text-center mb-8">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">{{ 'register.heading'|trans }}</h1>
                <p class="text-gray-500 text-sm">{{ 'register.subtitle'|trans }}</p>
            </div>

            {% include 'partials/_flash_messages.html.twig' %}

            {#
                Barrierefreie Felder über das kanonische Partial (_form_field.html.twig):
                Label mit for/id, Pflicht-Hinweis, Fehlertext am Feld über
                aria-describedby/aria-invalid, echter Fokus-outline (kein outline-none).
                autocomplete-Tokens kommen aus RegistrationType (name/email/new-password).

                Das erste fehlerhafte Feld bekommt autofocus — serverseitig, ohne JS
                (Muster wie partner/_form.html.twig). Ohne Fehler liegt der Fokus auf
                dem ersten Feld.
            #}
            {% set focus_field = null %}
            {% if registrationForm.name.vars.errors|length > 0 %}
                {% set focus_field = 'name' %}
            {% elseif registrationForm.email.vars.errors|length > 0 %}
                {% set focus_field = 'email' %}
            {% elseif registrationForm.plainPassword.first.vars.errors|length > 0 %}
                {% set focus_field = 'pw1' %}
            {% elseif registrationForm.plainPassword.second.vars.errors|length > 0 %}
                {% set focus_field = 'pw2' %}
            {% endif %}
            {% set focus_field = focus_field ?? 'name' %}

            {{ form_start(registrationForm, {'attr': {'class': 'space-y-5', 'novalidate': 'novalidate'}}) }}

                {{ include('partials/_form_field.html.twig', {
                    field: registrationForm.name,
                    autofocus: focus_field == 'name'
                }) }}

                {{ include('partials/_form_field.html.twig', {
                    field: registrationForm.email,
                    autofocus: focus_field == 'email'
                }) }}

                {{ include('partials/_form_field.html.twig', {
                    field: registrationForm.plainPassword.first,
                    autofocus: focus_field == 'pw1'
                }) }}

                {{ include('partials/_form_field.html.twig', {
                    field: registrationForm.plainPassword.second,
                    autofocus: focus_field == 'pw2'
                }) }}

                {#
                    Werbe-Einwilligung (Feature 04, AK-01).

                    ⚠️ Sie steht VOR dem Absenden-Knopf. Vorher rendert sie
                    `form_rest()` aus `form_end()` im Symfony-Standardlayout
                    UNTER den Knopf – gelesen wird sie dort nicht, und eine
                    nicht gelesene Einwilligung ist rechtlich wertlos.
                    `form_widget()` markiert das Feld als gerendert, `form_rest()`
                    überspringt es danach (der CSRF-Token bleibt unberührt).

                    Bewusst NICHT über `partials/_form_field.html.twig`: Das
                    Partial setzt das Label mit `block mb-1` ÜBER das Widget und
                    gibt dem Eingabefeld `w-full … px-4 py-2.5`. Bei einem Häkchen
                    gehört das Label daneben, nicht darüber, und ein 100 % breites
                    Kästchen wäre unbrauchbar. Zusätzlich schreibt das Partial in
                    jede Zeile einen Pflicht-/Optional-Hinweis – hier ein
                    überflüssiger zweiter Hinweistext neben dem Hilfetext.
                    Struktur und Klassen stammen deshalb aus dem `consent`-Block
                    von `partner/_form.html.twig`.

                    ⚠️ Kein Sternchen, kein `required`: Die Einwilligung darf
                    keine Bedingung für die Registrierung sein (AK-03,
                    Koppelungsverbot Art. 7 Abs. 4 DSGVO). `required: false` im
                    RegistrationType hält das `required`-Attribut fern; ohne
                    Constraint bleibt das Kästchen auch beim erneuten Rendern leer.

                    ⚠️ `aria-invalid` bekommt `false`, nicht `null` – in `attr`
                    unterdrückt nur `false` ein Attribut. `null` renderte
                    `aria-invalid=""`, und Screenreader lesen das als „ungültig".
                #}
                {% set consent = registrationForm.marketingConsent %}
                <div class="rounded-xl border border-gray-300 bg-gray-50 p-4 space-y-2">
                    <div class="flex items-start gap-3">
                        {{ form_widget(consent, {'attr': {
                            'class': 'mt-0.5 w-5 h-5 shrink-0 cursor-pointer rounded border-gray-500 text-cyan-700 focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700',
                            'aria-describedby': consent.vars.id ~ '_help ' ~ consent.vars.id ~ '_error',
                            'aria-invalid': consent.vars.errors|length > 0 ? 'true' : false,
                        }}) }}
                        {# min-h-[44px] auf dem Label: Das Kästchen allein misst
                           20 px; erst die klickbare Label-Fläche bringt das
                           Tap-Target über 44 px (die Seite wird überwiegend
                           mobil benutzt, es gibt eine PWA). #}
                        {{ form_label(consent, null, {'label_attr': {
                            'class': 'block min-h-[44px] text-sm text-gray-900 leading-relaxed cursor-pointer',
                        }}) }}
                    </div>

                    {# Container existiert immer – so zeigt aria-describedby nie ins Leere. #}
                    <p id="{{ consent.vars.id }}_error" class="text-sm font-semibold text-red-700">
                        {%- for error in consent.vars.errors %}{{ error.message }}{{ loop.last ? '' : ' ' }}{% endfor -%}
                    </p>

                    {# form_help statt eines eigenen Textes: Der Schlüssel
                       marketing.consent.help steht im RegistrationType, und
                       Symfony vergibt hier verlässlich die id `…_help`, auf die
                       das aria-describedby oben zeigt. #}
                    {{ form_help(consent, {'help_attr': {'class': 'text-xs text-gray-700'}}) }}
                </div>

                {# Absenden #}
                <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-lg shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5 focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
                    {{ 'register.submit'|trans }}
                </button>

            {{ form_end(registrationForm) }}

            {# Link zu Login #}
            <p class="text-center text-sm text-gray-500 mt-6">
                {{ 'register.has_account'|trans }}
                <a href="{{ path('app_login') }}" class="text-purple-600 font-semibold hover:text-purple-800 transition">{{ 'register.login_link'|trans }}</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
