{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ idea.title }}{% endblock %}

{% block admin_body %}
<a href="{{ path('admin_board_index') }}" class="inline-flex items-center min-h-[44px] text-cyan-700 focus:outline-2 focus:outline-offset-2">← {{ 'board.title'|trans }}</a>

<article class="mt-4 bg-white rounded-xl border border-gray-200 p-6">
    <div class="flex flex-wrap items-start justify-between gap-2">
        <h2 class="text-xl font-bold text-gray-900 wrap-anywhere">{{ idea.title }}</h2>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full {{ idea.status.badgeClasses }}">
            <span aria-hidden="true">{{ idea.status.emoji }}</span> {{ idea.status.transKey|trans }}
        </span>
    </div>
    <p class="mt-3 text-gray-700 whitespace-pre-line wrap-anywhere" lang="{{ idea.locale }}">{{ idea.description }}</p>
    <p class="mt-4 text-sm text-gray-500 wrap-anywhere">
        {{ authorName.forIdea(idea) ?? 'board.author_anonymous'|trans }}
        <span aria-hidden="true">·</span>{{ idea.createdAt|date('d.m.Y H:i') }}
        <span aria-hidden="true">·</span>{{ 'board.admin_votes'|trans }}: {{ voteCount }}
        <span aria-hidden="true">·</span>{{ idea.locale|upper }}
        {% if not idea.published %}<span aria-hidden="true">·</span>{{ 'board.admin_queue'|trans }}{% endif %}
    </p>
</article>

{% if not idea.published %}
    <div class="mt-6 grid gap-4 md:grid-cols-2">
        <form method="post" action="{{ path('admin_board_publish', {id: idea.id}) }}" class="bg-white rounded-xl border border-gray-200 p-5">
            <input type="hidden" name="_token" value="{{ csrf_token('board-publish-' ~ idea.id) }}">
            <button type="submit" class="min-h-[44px] px-5 rounded-lg bg-green-600 text-white font-semibold focus:outline-2 focus:outline-offset-2 hover:bg-green-700">
                {{ 'board.admin_publish'|trans }}
            </button>
        </form>

        <form method="post" action="{{ path('admin_board_delete', {id: idea.id}) }}" class="bg-white rounded-xl border border-gray-200 p-5">
            <input type="hidden" name="_token" value="{{ csrf_token('board-delete-' ~ idea.id) }}">
            <button type="submit" class="min-h-[44px] px-5 rounded-lg border border-red-300 text-red-700 font-semibold focus:outline-2 focus:outline-offset-2 hover:bg-red-50">
                {{ 'board.admin_delete'|trans }}
            </button>
        </form>
    </div>
{% endif %}

{# Ablehnen — ⚠ ohne Begründung geschieht nichts (AK-27). #}
<form method="post" action="{{ path('admin_board_decline', {id: idea.id}) }}" class="mt-6 bg-white rounded-xl border border-gray-200 p-5">
    <input type="hidden" name="_token" value="{{ csrf_token('board-decline-' ~ idea.id) }}">
    <label for="reason" class="block font-medium text-gray-800">{{ 'board.admin_reason'|trans }}</label>
    <p id="reason_help" class="text-sm text-gray-500">{{ 'board.admin_reason_help'|trans }}</p>
    <textarea name="reason" id="reason" rows="4" aria-describedby="reason_help" required
              class="mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-2 focus:outline-offset-2">{{ idea.teamResponse }}</textarea>
    <button type="submit" class="mt-3 min-h-[44px] px-5 rounded-lg bg-gray-800 text-white font-semibold focus:outline-2 focus:outline-offset-2 hover:bg-gray-900">
        {{ 'board.admin_decline'|trans }}
    </button>
</form>

{% if idea.published %}
    <form method="post" action="{{ path('admin_board_status', {id: idea.id}) }}" class="mt-6 bg-white rounded-xl border border-gray-200 p-5">
        <input type="hidden" name="_token" value="{{ csrf_token('board-status-' ~ idea.id) }}">
        <label for="status" class="block font-medium text-gray-800">{{ 'board.admin_status'|trans }}</label>
        <select name="status" id="status" class="mt-2 min-h-[44px] rounded-lg border border-gray-300 px-3 focus:outline-2 focus:outline-offset-2">
            {% for fall in statuses %}
                <option value="{{ fall.value }}" {{ fall == idea.status ? 'selected' }}>{{ fall.transKey|trans }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="ml-2 min-h-[44px] px-5 rounded-lg bg-cyan-700 text-white font-semibold focus:outline-2 focus:outline-offset-2 hover:bg-cyan-800">
            {{ 'board.admin_save'|trans }}
        </button>
    </form>

    <form method="post" action="{{ path('admin_board_response', {id: idea.id}) }}" class="mt-6 bg-white rounded-xl border border-gray-200 p-5">
        <input type="hidden" name="_token" value="{{ csrf_token('board-response-' ~ idea.id) }}">
        <label for="response" class="block font-medium text-gray-800">{{ 'board.admin_response'|trans }}</label>
        <textarea name="response" id="response" rows="4"
                  class="mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-2 focus:outline-offset-2">{{ idea.teamResponse }}</textarea>
        <button type="submit" class="mt-3 min-h-[44px] px-5 rounded-lg bg-cyan-700 text-white font-semibold focus:outline-2 focus:outline-offset-2 hover:bg-cyan-800">
            {{ 'board.admin_save'|trans }}
        </button>
    </form>
{% endif %}

<form method="post" action="{{ path('admin_board_merge', {id: idea.id}) }}" class="mt-6 bg-white rounded-xl border border-gray-200 p-5">
    <input type="hidden" name="_token" value="{{ csrf_token('board-merge-' ~ idea.id) }}">
    <label for="target" class="block font-medium text-gray-800">{{ 'board.admin_merge'|trans }}</label>
    <select name="target" id="target" class="mt-2 min-h-[44px] w-full rounded-lg border border-gray-300 px-3 focus:outline-2 focus:outline-offset-2">
        <option value="">{{ 'board.admin_merge_target'|trans }} …</option>
        {% for kandidat in candidates|filter(k => k.id != idea.id) %}
            <option value="{{ kandidat.id }}">{{ kandidat.title }}</option>
        {% endfor %}
    </select>
    <button type="submit" class="mt-3 min-h-[44px] px-5 rounded-lg border border-gray-300 font-semibold focus:outline-2 focus:outline-offset-2 hover:bg-gray-50">
        {{ 'board.admin_merge'|trans }}
    </button>
</form>
{% endblock %}
