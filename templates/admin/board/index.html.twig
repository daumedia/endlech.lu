{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ 'board.title'|trans }}{% endblock %}

{% block admin_body %}
<h2 class="text-2xl font-bold text-gray-800 mb-6">{{ 'board.admin_queue'|trans }}</h2>

{% if awaiting is empty %}
    <p class="bg-white rounded-xl border border-gray-200 p-6 text-gray-600">{{ 'board.admin_none_waiting'|trans }}</p>
{% else %}
    <div class="space-y-3">
        {% for idea in awaiting %}
            {% set stufe = levels[idea.id]|default('ok') %}
            {#
                Zwei Stufen (AK-73, AK-79). ⚠ Farbe trägt nie allein: Jede Stufe
                hat ein eigenes Wort, sonst wäre der Unterschied nur farbig.
            #}
            <article class="bg-white rounded-xl border p-4
                {{ stufe == 'overdue' ? 'border-red-300 bg-red-50' : (stufe == 'due_soon' ? 'border-amber-300 bg-amber-50' : 'border-gray-200') }}">
                <div class="flex flex-wrap items-start justify-between gap-2">
                    <a href="{{ path('admin_board_show', {id: idea.id}) }}"
                       class="font-bold text-gray-900 wrap-anywhere hover:text-cyan-700 focus:outline-2 focus:outline-offset-2">{{ idea.title }}</a>

                    {% if stufe != 'ok' %}
                        <span class="text-xs font-bold px-2.5 py-1 rounded-full
                            {{ stufe == 'overdue' ? 'bg-red-200 text-red-900' : 'bg-amber-200 text-amber-900' }}">
                            {{ (stufe == 'overdue' ? 'board.admin_overdue' : 'board.admin_due_soon')|trans }}
                        </span>
                    {% endif %}
                </div>

                <p class="mt-2 text-sm text-gray-600 whitespace-pre-line wrap-anywhere" lang="{{ idea.locale }}">{{ idea.description }}</p>

                <p class="mt-3 text-xs text-gray-500 wrap-anywhere">
                    {{ authorName.forIdea(idea) ?? 'board.author_anonymous'|trans }}
                    <span aria-hidden="true">·</span>
                    {{ 'board.admin_waiting_since'|trans({'%date%': idea.createdAt|date('d.m.Y')}) }}
                    <span aria-hidden="true">·</span>{{ idea.locale|upper }}
                </p>

                <div class="mt-3 flex flex-wrap gap-2">
                    <form method="post" action="{{ path('admin_board_publish', {id: idea.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('board-publish-' ~ idea.id) }}">
                        <button type="submit" class="min-h-[44px] px-4 rounded-lg bg-green-600 text-white text-sm font-semibold focus:outline-2 focus:outline-offset-2 hover:bg-green-700">
                            {{ 'board.admin_publish'|trans }}
                        </button>
                    </form>
                    <a href="{{ path('admin_board_show', {id: idea.id}) }}"
                       class="min-h-[44px] inline-flex items-center px-4 rounded-lg border border-gray-300 text-sm focus:outline-2 focus:outline-offset-2">
                        {{ 'board.admin_decline'|trans }} / {{ 'board.admin_delete'|trans }}
                    </a>
                </div>
            </article>
        {% endfor %}
    </div>
{% endif %}

<h2 class="text-2xl font-bold text-gray-800 mt-10 mb-4">{{ 'board.admin_published'|trans }}</h2>
<div class="bg-white rounded-xl border border-gray-200 divide-y divide-gray-100">
    {% for idea in published %}
        <div class="p-4 flex flex-wrap items-center justify-between gap-2">
            <a href="{{ path('admin_board_show', {id: idea.id}) }}"
               class="font-medium text-gray-900 wrap-anywhere hover:text-cyan-700 focus:outline-2 focus:outline-offset-2">{{ idea.title }}</a>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full {{ idea.status.badgeClasses }}">
                <span aria-hidden="true">{{ idea.status.emoji }}</span> {{ idea.status.transKey|trans }}
            </span>
        </div>
    {% else %}
        <p class="p-4 text-gray-600">—</p>
    {% endfor %}
</div>
{% endblock %}
