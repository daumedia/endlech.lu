{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ 'admin.finance.edit_title'|trans }}{% endblock %}

{% block admin_body %}
<h2 class="text-2xl font-bold text-gray-800 mb-6">{{ 'admin.finance.edit_title'|trans }}</h2>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    {{ include('admin/finance/_form.html.twig', {button_label: 'admin.finance.save'|trans}) }}
</div>

<p class="mt-4 text-xs text-gray-500">
    {{ 'admin.finance.updated_at'|trans({'%date%': entry.updatedAt|date('d.m.Y H:i')}) }}
</p>
{% endblock %}
