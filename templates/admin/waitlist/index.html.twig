{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ 'admin.waitlist.title'|trans }}{% endblock %}

{#
    Kombinierte Liste aller drei Wartelisten. Der Controller normalisiert
    Partner-, Organisations- und App-Einträge zu einheitlichen Zeilen, damit
    hier keine Entity-Fallunterscheidung nötig ist.

    ⚠ Jede Zeilenart führt DIESELBE Schlüsselmenge (auch die für sie leeren
    Schlüssel). Auf `row.platform` darf deshalb überall zugegriffen werden;
    unter `strict_variables: true` wäre ein fehlender Schlüssel kein „null",
    sondern ein Laufzeitfehler.

    ⚠ Die E-Mail-Adresse steht in der Zeile, wird aber NICHT angezeigt — sie
    dient allein dem Nachschlagen des Brevo-Sync-Zustands. Bei App-Zeilen wiegt
    das schwerer als bei den anderen: dort IST die Adresse der ganze Datensatz.
#}
{% macro filter_link(label, params, active, count) %}
    <a href="{{ path('admin_waitlist_index', params) }}"
       {% if active %}aria-current="page"{% endif %}
       class="px-3 py-1.5 rounded-full text-xs font-bold focus:outline-2 focus:outline-offset-2 focus:outline-purple-700 {{ active ? 'bg-purple-700 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }}">
        {{ label }}{% if count is not null %} ({{ count }}){% endif %}
    </a>
{% endmacro %}

{% block admin_body %}
    {% import _self as ui %}
    {% set sort = direction|lower %}

    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-800">{{ 'admin.waitlist.title'|trans }}</h2>
        <div class="flex items-center gap-2">
            {#
                AK-27: die Gegenprobe zur Kontaktzahl in Brevo. Die beiden Zahlen
                müssen übereinstimmen — und nach einem Widerruf zugleich sinken.
                Steht sie hier, fällt eine Lücke beim Draufschauen auf; sonst
                erst dann, wenn eine Kampagne jemanden nicht erreicht.

                Nur sichtbar, sobald es überhaupt Einwilligungen gibt: eine
                dauerhafte „0 eingewilligt"-Kachel wäre Rauschen.
            #}
            {% if marketingConsented > 0 %}
                <span class="bg-purple-100 text-purple-800 text-xs font-bold px-3 py-1 rounded-full">
                    {{ 'marketing.admin.summary'|trans({
                        '%consented%': marketingConsented,
                        '%synced%': marketingCounts['synced']|default(0),
                    }) }}
                </span>
            {% endif %}
            <span class="bg-cyan-100 text-cyan-800 text-xs font-bold px-3 py-1 rounded-full">
                {{ 'admin.waitlist.total'|trans({'%count%': rows|length}) }}
            </span>
        </div>
    </div>

    {# Filter als Links: teilbar, lesezeichenfähig, ohne JavaScript. #}
    <div class="space-y-3 mb-6">
        <nav class="flex flex-wrap items-center gap-2" aria-label="{{ 'admin.waitlist.filter_source'|trans }}">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider mr-1">{{ 'admin.waitlist.filter_source'|trans }}</span>
            {# ⚠ Die Zahl an „Alle" MUSS alle drei Quellen zusammenzählen. Stand
               hier nur die Summe zweier Wartelisten, wäre sie kleiner als die
               Liste darunter lang ist — und niemand wüsste, welche der beiden
               Zahlen stimmt. #}
            {{ ui.filter_link('admin.waitlist.filter_all'|trans, {sort: sort, status: activeStatus ? activeStatus.value : null}, activeSource is null and activeType is null, partnerTotal + organisationTotal + appTotal) }}
            {{ ui.filter_link('admin.waitlist.source_partner'|trans, {source: 'partner', sort: sort, status: activeStatus ? activeStatus.value : null}, activeSource == 'partner', partnerTotal) }}
            {{ ui.filter_link('admin.waitlist.source_organisation'|trans, {source: 'organisation', sort: sort, status: activeStatus ? activeStatus.value : null}, activeSource == 'organisation' and activeType is null, organisationTotal) }}
            {{ ui.filter_link('admin.waitlist.source_app'|trans, {source: 'app', sort: sort, status: activeStatus ? activeStatus.value : null}, activeSource == 'app', appTotal) }}
        </nav>

        <nav class="flex flex-wrap items-center gap-2" aria-label="{{ 'admin.waitlist.filter_type'|trans }}">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider mr-1">{{ 'admin.waitlist.filter_type'|trans }}</span>
            {% for type in types %}
                {{ ui.filter_link(type.emoji ~ ' ' ~ type.transKey|trans, {type: type.value, sort: sort, status: activeStatus ? activeStatus.value : null}, activeType == type, typeCounts[type.value] ?? 0) }}
            {% endfor %}
        </nav>

        <nav class="flex flex-wrap items-center gap-2" aria-label="{{ 'admin.waitlist.filter_status'|trans }}">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider mr-1">{{ 'admin.waitlist.filter_status'|trans }}</span>
            {{ ui.filter_link('admin.waitlist.filter_all'|trans, {source: activeSource, type: activeType ? activeType.value : null, sort: sort}, activeStatus is null, null) }}
            {% for status in statuses %}
                {{ ui.filter_link(status.emoji ~ ' ' ~ status.transKey|trans, {source: activeSource, type: activeType ? activeType.value : null, status: status.value, sort: sort}, activeStatus == status, null) }}
            {% endfor %}
        </nav>
    </div>

    {% if rows is empty %}
        <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-500">
            {{ 'admin.waitlist.empty'|trans }}
        </div>
    {% else %}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th scope="col" class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                            <a href="{{ path('admin_waitlist_index', {
                                    source: activeSource, type: activeType ? activeType.value : null,
                                    status: activeStatus ? activeStatus.value : null,
                                    sort: direction == 'ASC' ? 'desc' : 'asc'
                                }) }}"
                               class="inline-flex items-center gap-1 hover:text-purple-700 focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
                                {{ 'admin.waitlist.table.date'|trans }}
                                <span aria-hidden="true">{{ direction == 'ASC' ? '↑' : '↓' }}</span>
                                <span class="sr-only">{{ (direction == 'ASC' ? 'admin.waitlist.sort_asc' : 'admin.waitlist.sort_desc')|trans }}</span>
                            </a>
                        </th>
                        <th scope="col" class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'admin.waitlist.table.source'|trans }}</th>
                        <th scope="col" class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'admin.waitlist.table.name'|trans }}</th>
                        <th scope="col" class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider hidden md:table-cell">{{ 'admin.waitlist.table.contact'|trans }}</th>
                        <th scope="col" class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'admin.waitlist.table.status'|trans }}</th>
                        <th scope="col" class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider hidden lg:table-cell">{{ 'marketing.admin.column'|trans }}</th>
                        <th scope="col" class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'admin.waitlist.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for row in rows %}
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-4 py-3 text-gray-500 whitespace-nowrap">{{ row.createdAt|date('d.m.Y') }}</td>
                            {#
                                Die Quelle wird über `row.kind` entschieden, nicht
                                über das Vorhandensein anderer Felder. Bis zur
                                dritten Zeilenart stand hier „Typ gesetzt →
                                Organisation, sonst Partner"; eine App-Zeile führt
                                keinen Typ und wäre darüber als Restaurant
                                ausgewiesen worden.
                            #}
                            <td class="px-4 py-3">
                                {% if row.kind == 'organisation' and row.type %}
                                    <span class="{{ row.type.badgeClasses }} text-xs font-bold px-2 py-0.5 rounded-full whitespace-nowrap">
                                        {{ row.type.emoji }} {{ row.type.transKey|trans }}
                                    </span>
                                {% elseif row.kind == 'app' %}
                                    <span class="bg-gray-100 text-gray-700 text-xs font-bold px-2 py-0.5 rounded-full whitespace-nowrap">
                                        📱 {{ 'admin.waitlist.source_app'|trans }}
                                    </span>
                                {% else %}
                                    <span class="bg-gray-100 text-gray-700 text-xs font-bold px-2 py-0.5 rounded-full whitespace-nowrap">
                                        🍽️ {{ 'admin.waitlist.source_partner'|trans }}
                                    </span>
                                {% endif %}
                            </td>
                            {#
                                AK-35: Bei einer App-Vormerkung IST der Name die
                                Plattform (`AppWaitlistEntry::getDisplayName()`) —
                                sie steht deshalb als Abzeichen statt als
                                Fließtext, und würde sonst zweimal in derselben
                                Zeile stehen.

                                Form und Größe kommen aus dem Template, die Farbe
                                aus `AppPlatform::badgeClasses()`. Dasselbe Muster
                                wie bei `WaitlistStatus` und `OrganisationType`:
                                Eine hier ausgeschriebene Farbe liefe beim
                                nächsten Plattformfall auseinander.
                            #}
                            <td class="px-4 py-3 font-semibold text-gray-800">
                                {% if row.platform %}
                                    <span class="{{ row.platform.badgeClasses }} text-xs font-bold px-2 py-0.5 rounded-full whitespace-nowrap">
                                        {{ row.platform.emoji }} {{ row.platform.label }}
                                    </span>
                                {% else %}
                                    {{ row.name }}
                                {% endif %}
                                {% if row.detail %}
                                    <span class="block text-xs font-normal text-gray-500">{{ row.detail }}</span>
                                {% endif %}
                            </td>
                            {# App-Zeilen führen keinen Ansprechpartner — und
                               erfinden auch keinen (siehe AppWaitlistEntry). Der
                               Gedankenstrich ist Zeichensetzung für Sehende und
                               bleibt aus der Vorlesereihenfolge. #}
                            <td class="px-4 py-3 text-gray-600 hidden md:table-cell">
                                {%- if row.contact is empty -%}
                                    <span class="text-gray-400" aria-hidden="true">{{ 'marketing.admin.not_applicable'|trans }}</span>
                                {%- else -%}
                                    {{ row.contact }}
                                {%- endif -%}
                            </td>
                            <td class="px-4 py-3">
                                <span class="{{ row.status.badgeClasses }} text-xs font-bold px-2 py-0.5 rounded-full whitespace-nowrap">
                                    {{ row.status.emoji }} {{ row.status.transKey|trans }}
                                </span>
                            </td>
                            {#
                                Sync-Zustand (Feature 04, AK-26). Vier Zustände,
                                und der häufigste ist der leere: Die meisten
                                Zeilen tragen keine Werbe-Einwilligung.

                                Das Abzeichen trägt Farbe UND Text — Farbe trägt
                                hier nie allein (docs/design-system.md). Ein
                                festgefahrener Auftrag bekommt zusätzlich ein
                                Warnzeichen, damit er sich beim Überfliegen der
                                Liste von einem frisch fehlgeschlagenen abhebt.
                            #}
                            <td class="px-4 py-3 hidden lg:table-cell">
                                {%- if row.marketing -%}
                                    <span class="{{ row.marketing.syncState.badgeClasses }} text-xs font-bold px-2 py-0.5 rounded-full whitespace-nowrap">
                                        {%- if row.marketing.isStuck %}⚠ {% endif -%}
                                        {{ row.marketing.syncState.transKey|trans }}
                                        {%- if row.marketing.syncState.value == 'synced' and row.marketing.syncedAt %}
                                            <span class="font-normal">· {{ row.marketing.syncedAt|date('d.m.Y') }}</span>
                                        {% endif -%}
                                    </span>
                                {%- elseif row.marketingConsentAt -%}
                                    {# Eingewilligt, aber noch keine Zeile im
                                       Auftragsbuch: Die Bestätigung steht aus. #}
                                    <span class="text-xs text-gray-500">{{ 'marketing_sync_state.pending'|trans }}</span>
                                {%- else -%}
                                    {# `aria-label` auf einem nicht-interaktiven <span> wird nicht
                                       von jedem Screenreader vorgelesen; ein sr-only-Text schon.
                                       Der Gedankenstrich bleibt für Sehende, aria-hidden hält ihn
                                       aus der Vorlesereihenfolge. #}
                                    <span class="text-gray-400" aria-hidden="true">{{ 'marketing.admin.not_applicable'|trans }}</span>
                                    <span class="sr-only">{{ 'marketing.admin.consent_none'|trans }}</span>
                                {%- endif -%}
                            </td>
                            <td class="px-4 py-3 text-right">
                                <a href="{{ path(row.route, {id: row.id}) }}"
                                   class="text-purple-700 font-semibold hover:underline focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
                                    {{ 'admin.waitlist.view'|trans }}
                                    <span class="sr-only">– {{ row.name }}</span>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
