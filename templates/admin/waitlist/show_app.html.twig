{% extends 'admin/base.html.twig' %}

{#
    Detailansicht einer App-Vormerkung (Feature 08, AK-35).

    Aufbau wie `organisation_show.html.twig` und `partner_show.html.twig` —
    dieselben Bausteine (`_field`, `_status_form`, `_timestamps`, `_marketing`),
    damit ein Eingriff an einer Warteliste nicht an den beiden anderen vorbeigeht.

    Der Unterschied zu jenen ist der schmale Datensatz: Es gibt keinen Namen,
    keinen Ansprechpartner und keine Nachricht. Was diese Seite über die Liste
    hinaus trägt, sind drei Angaben — die Adresse, der Bestätigungsstand und der
    Zeitpunkt des Beta-Versands.
#}

{% block admin_title %}{{ entry.platform ? entry.platform.label : entry.email }}{% endblock %}

{% block admin_body %}
    <a href="{{ path('admin_waitlist_index', {source: 'app'}) }}"
       class="inline-block mb-4 text-sm text-gray-500 hover:text-purple-700 focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
        ← {{ 'admin.waitlist.back'|trans }}
    </a>

    <div class="flex items-center justify-between mb-6 gap-4 flex-wrap">
        {# Die Adresse ist hier die Überschrift: Einen Namen erhebt dieses
           Feature nicht, und die Plattform steht daneben als Abzeichen. #}
        <h2 class="text-2xl font-bold text-gray-800 break-all">📱 {{ entry.email }}</h2>
        <div class="flex items-center gap-2">
            {% if entry.platform %}
                {# Farbe aus `AppPlatform::badgeClasses()`, Form und Größe von
                   hier — dasselbe Muster wie bei Status und Organisationstyp. #}
                <span class="{{ entry.platform.badgeClasses }} text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap">
                    {{ entry.platform.emoji }} {{ entry.platform.label }}
                </span>
            {% endif %}
            <span class="{{ entry.status.badgeClasses }} text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap">
                {{ entry.status.emoji }} {{ entry.status.transKey|trans }}
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">{{ 'admin.waitlist.details'|trans }}</h3>

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.email'|trans, value: entry.email, mailto: true}) }}
                {{ include('admin/waitlist/_field.html.twig', {
                    label: 'admin.waitlist.field.platform'|trans,
                    value: entry.platform ? entry.platform.transKey|trans : null
                }) }}
                {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.language'|trans, value: entry.locale}) }}
                {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.source'|trans, value: entry.source}) }}
            </dl>

            {#
                Der Beta-Versand bekommt einen eigenen Block statt einer Zeile
                unter „Angaben": Er ist die einzige Auskunft, die eine Nachfrage
                „ich habe nichts bekommen" beantwortet. Zwischen Sprache und
                Quelle wäre er beim Überfliegen nicht zu finden — genau dann,
                wenn jemand am Telefon wartet.
            #}
            <div class="mt-6 pt-6 border-t border-gray-200">
                <h4 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3">{{ 'admin.waitlist.beta_heading'|trans }}</h4>

                {% if entry.betaLinkSentAt %}
                    <p class="text-sm font-semibold text-gray-800">
                        {{ 'admin.waitlist.field.beta_link_sent'|trans }}:
                        <span class="font-bold">{{ entry.betaLinkSentAt|date('d.m.Y H:i') }}</span>
                    </p>
                {% else %}
                    <p class="text-sm text-gray-600">{{ 'admin.waitlist.beta_not_sent'|trans }}</p>
                {% endif %}

                {#
                    `hasBeta()` beantwortet die Frage, nicht ein
                    `platform == 'ios'` an dieser Stelle: Sie wird an vier
                    Stellen gestellt, und vier verstreute Vergleiche laufen beim
                    ersten Android-Build auseinander.
                #}
                {% if entry.platform and not entry.platform.hasBeta %}
                    <p class="mt-2 text-xs text-amber-800 bg-amber-50 rounded-lg px-3 py-2">
                        {{ 'admin.waitlist.beta_no_build'|trans({'%platform%': entry.platform.label}) }}
                    </p>
                {% endif %}
            </div>

            {# Eingegangen · Einwilligung · Bestätigt — geteilt mit den beiden
               anderen Wartelisten. #}
            {{ include('admin/waitlist/_timestamps.html.twig', {entry: entry}) }}

            {#
                ⚠ `confirmedAt` und `selfConfirmedAt` bedeuten Verschiedenes und
                dürfen deshalb nicht in einer Zeile stehen (BF-83/BF-89):
                `confirmedAt` kann aus einem Statuswechsel in der Verwaltung
                stammen, `selfConfirmedAt` setzt allein der eingelöste
                Bestätigungslink. Nur letzteres belegt, dass die Adresse dem
                gehört, der eingetragen ist — und nur damit darf Werbung raus.
            #}
            <div class="mt-4 pt-4 border-t border-gray-200 text-xs text-gray-500">
                <dl>
                    <dt class="mb-0.5">{{ 'admin.waitlist.field.self_confirmed'|trans }}</dt>
                    <dd class="font-semibold {{ entry.selfConfirmedAt ? 'text-gray-700' : 'text-amber-800' }}">
                        {{ entry.selfConfirmedAt ? entry.selfConfirmedAt|date('d.m.Y H:i') : 'admin.waitlist.self_confirmed_missing'|trans }}
                    </dd>
                </dl>
                <p class="mt-2 leading-relaxed">{{ 'admin.waitlist.self_confirmed_hint'|trans }}</p>
            </div>
        </div>

        <div class="space-y-6">
            {{ include('admin/waitlist/_status_form.html.twig', {
                entry: entry, route: 'admin_waitlist_app_status', statuses: statuses
            }) }}

            {# Werbe-Einwilligung und Brevo-Sync-Zustand — identisch zu den
               beiden anderen Detailseiten. #}
            {{ include('admin/waitlist/_marketing.html.twig', {
                entry: entry, marketingContact: marketingContact
            }) }}
        </div>
    </div>
{% endblock %}
