{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ entry.organisationName }}{% endblock %}

{% block admin_body %}
    <a href="{{ path('admin_waitlist_index') }}"
       class="inline-block mb-4 text-sm text-gray-500 hover:text-purple-700 focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
        ← {{ 'admin.waitlist.back'|trans }}
    </a>

    <div class="flex items-center justify-between mb-6 gap-4 flex-wrap">
        <h2 class="text-2xl font-bold text-gray-800">{{ entry.type.emoji }} {{ entry.organisationName }}</h2>
        <div class="flex items-center gap-2">
            <span class="{{ entry.type.badgeClasses }} text-xs font-bold px-3 py-1 rounded-full">
                {{ entry.type.transKey|trans }}
            </span>
            <span class="{{ entry.status.badgeClasses }} text-xs font-bold px-3 py-1 rounded-full">
                {{ entry.status.emoji }} {{ entry.status.transKey|trans }}
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">{{ 'admin.waitlist.details'|trans }}</h3>

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.contact'|trans, value: entry.contactName}) }}
                {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.role'|trans, value: entry.contactRole}) }}
                {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.email'|trans, value: entry.email, mailto: true}) }}
                {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.phone'|trans, value: entry.phone, tel: true}) }}
                {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.website'|trans, value: entry.website}) }}
                {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.language'|trans, value: entry.locale}) }}
                {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.source'|trans, value: entry.source}) }}
            </dl>

            {# Typspezifische Angaben – je nach Typ ist nur ein Block gefüllt. #}
            <div class="mt-6 pt-6 border-t border-gray-200">
                <h4 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3">
                    {{ ('admin.waitlist.specific_' ~ entry.type.value)|trans }}
                </h4>

                {% if entry.type.value == 'commune' %}
                    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
                        {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.commune'|trans, value: entry.communeName}) }}
                        {{ include('admin/waitlist/_field.html.twig', {label: 'admin.waitlist.field.venues'|trans, value: entry.estimatedVenues}) }}
                        {{ include('admin/waitlist/_field.html.twig', {
                            label: 'admin.waitlist.field.timeframe'|trans,
                            value: entry.timeframe ? entry.timeframe.transKey|trans : null
                        }) }}
                    </dl>
                {% elseif entry.type.value == 'company' %}
                    {% if entry.sponsorshipInterests|length %}
                        <ul class="flex flex-wrap gap-2">
                            {% for interest in entry.sponsorshipInterests %}
                                <li class="bg-purple-100 text-purple-800 text-xs font-semibold px-2.5 py-1 rounded-full">
                                    {{ ('organisation.sponsorship.' ~ interest)|trans }}
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-sm text-gray-400">{{ 'admin.waitlist.none_selected'|trans }}</p>
                    {% endif %}
                {% else %}
                    {% if entry.collaborationInterests|length %}
                        <ul class="flex flex-wrap gap-2">
                            {% for interest in entry.collaborationInterests %}
                                <li class="bg-teal-100 text-teal-800 text-xs font-semibold px-2.5 py-1 rounded-full">
                                    {{ ('organisation.collaboration.' ~ interest)|trans }}
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-sm text-gray-400">{{ 'admin.waitlist.none_selected'|trans }}</p>
                    {% endif %}
                    <p class="mt-3 text-xs text-teal-800">{{ 'admin.waitlist.association_reminder'|trans }}</p>
                {% endif %}
            </div>

            {% if entry.message %}
                <div class="mt-6 pt-6 border-t border-gray-200">
                    <h4 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-2">{{ 'admin.waitlist.field.message'|trans }}</h4>
                    <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-line">{{ entry.message }}</p>
                </div>
            {% endif %}

            {{ include('admin/waitlist/_timestamps.html.twig', {entry: entry}) }}
        </div>

        <div class="space-y-6">
            {{ include('admin/waitlist/_status_form.html.twig', {
                entry: entry, route: 'admin_waitlist_organisation_status', statuses: statuses
            }) }}
        </div>
    </div>
{% endblock %}
