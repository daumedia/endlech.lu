{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ 'admin.restaurant.edit_title'|trans({'%name%': restaurant.name}) }}{% endblock %}

{% block admin_body %}
<div class="mb-6">
    <a href="{{ path('admin_restaurant_index') }}" class="text-purple-600 hover:text-purple-800 font-semibold text-sm transition">
        ← {{ 'admin.restaurant.back_to_list'|trans }}
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 max-w-3xl">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">{{ restaurant.emoji }} {{ 'admin.restaurant.edit_title'|trans({'%name%': restaurant.name}) }}</h2>

    {% include 'admin/restaurant/_form.html.twig' with {
        form: form,
        button_label: 'admin.restaurant.save_button'|trans
    } %}
</div>

{# --- FOTO-VERWALTUNG --- #}
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 max-w-3xl mt-6">
    <h3 class="text-lg font-bold text-gray-800 mb-4">📷 {{ 'admin.photos.title'|trans }}</h3>

    {# Bestehende Bilder (sortierbar per Drag & Drop) #}
    {% if restaurant.images is not empty %}
    <p class="text-xs text-gray-500 mb-3">{{ 'admin.photos.drag_hint'|trans }}</p>
    <div data-controller="image-sort"
         data-image-sort-url-value="{{ path('admin_restaurant_image_sort', {id: restaurant.id}) }}"
         data-image-sort-token-value="{{ csrf_token('sort-images-' ~ restaurant.id) }}"
         class="mb-6">
        <div data-image-sort-target="list" class="space-y-2">
            {% for image in restaurant.images %}
            <div data-image-id="{{ image.id }}" class="flex items-center gap-3 bg-gray-50 border border-gray-200 rounded-lg p-2 group">
                {# Drag Handle – reine Maus-Geste, für Tastatur/Screenreader ausgeblendet;
                   die Auf/Ab-Knöpfe daneben sind die zugängliche Alternative. #}
                <span class="drag-handle cursor-grab active:cursor-grabbing text-gray-400 hover:text-gray-600 px-1" aria-hidden="true">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16"/>
                    </svg>
                </span>
                {# Sortieren ohne Ziehen: Auf/Ab-Knöpfe senden über denselben
                   image-sort-Endpunkt wie Drag & Drop die neue Reihenfolge.
                   Zugänglicher Name über aria-label; das Glyph ist dekorativ. #}
                <div class="flex items-center gap-1 shrink-0">
                    <button type="button"
                            data-action="image-sort#moveUp"
                            data-sort-button="up"
                            aria-label="{{ 'admin.photos.move_up'|trans }}"
                            class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center rounded-lg text-gray-500 hover:text-gray-800 hover:bg-gray-200 transition focus:outline-2 focus:outline-offset-2 focus:outline-purple-700 disabled:opacity-30 disabled:cursor-not-allowed">
                        <span aria-hidden="true">▲</span>
                    </button>
                    <button type="button"
                            data-action="image-sort#moveDown"
                            data-sort-button="down"
                            aria-label="{{ 'admin.photos.move_down'|trans }}"
                            class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center rounded-lg text-gray-500 hover:text-gray-800 hover:bg-gray-200 transition focus:outline-2 focus:outline-offset-2 focus:outline-purple-700 disabled:opacity-30 disabled:cursor-not-allowed">
                        <span aria-hidden="true">▼</span>
                    </button>
                </div>
                {# Thumbnail #}
                <img src="/uploads/restaurants/{{ image.filename }}" alt="{{ image.altText }}"
                     class="w-20 h-14 object-cover rounded border border-gray-200 shrink-0">
                {# Info + Cover-Badge #}
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                        <span data-cover-badge class="inline-block text-xs font-bold text-purple-700 bg-purple-100 px-2 py-0.5 rounded-full border border-purple-200" {% if not loop.first %}style="display: none"{% endif %}>
                            {{ 'admin.photos.cover_badge'|trans }}
                        </span>
                        {% if image.altText %}
                        <p class="text-xs text-gray-500 truncate">{{ image.altText }}</p>
                        {% endif %}
                    </div>
                </div>
                {# Löschen-Button #}
                <form method="post"
                      action="{{ path('admin_restaurant_image_delete', {id: restaurant.id, imageId: image.id}) }}"
                      onsubmit="return confirm('{{ 'admin.photos.delete_confirm'|trans }}')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-image-' ~ image.id) }}">
                    <button type="submit" class="min-h-[44px] inline-flex items-center text-red-500 hover:text-red-700 text-xs font-bold px-3 py-1 shrink-0 transition opacity-0 group-hover:opacity-100 focus:opacity-100 focus-visible:opacity-100 focus:outline-2 focus:outline-offset-2 focus:outline-red-700">
                        {{ 'admin.photos.delete_button'|trans }}
                    </button>
                </form>
            </div>
            {% endfor %}
        </div>
    </div>
    {% else %}
    <p class="text-sm text-gray-400 mb-4">{{ 'admin.photos.no_photos'|trans }}</p>
    {% endif %}

    {# Upload-Formular #}
    <form method="post" enctype="multipart/form-data"
          action="{{ path('admin_restaurant_image_upload', {id: restaurant.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('upload-images-' ~ restaurant.id) }}">
        <div class="mb-3">
            {# Alt-Text ist für Barrierefreiheit Pflicht: kein Bild ohne Beschreibung. #}
            <label for="admin-photo-alt" class="block text-sm font-semibold text-gray-700 mb-1">
                {{ 'admin.photos.alt_text_label'|trans }} <span class="text-red-600" aria-hidden="true">*</span>
            </label>
            <input type="text" id="admin-photo-alt" name="altText" required aria-required="true"
                   placeholder="{{ 'admin.photos.alt_text_placeholder'|trans }}"
                   class="w-full min-h-[44px] border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
        </div>
        <div class="mb-3">
            <label for="admin-photo-files" class="block text-sm font-semibold text-gray-700 mb-1">{{ 'admin.photos.upload_label'|trans }}</label>
            <input type="file" id="admin-photo-files" name="images[]" multiple required accept="image/jpeg,image/png,image/webp"
                   class="block w-full text-sm text-gray-600 rounded-lg focus:outline-2 focus:outline-offset-2 focus:outline-purple-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100">
        </div>
        <button type="submit" class="inline-flex items-center justify-center min-h-[44px] bg-purple-600 hover:bg-purple-700 text-white font-medium py-2 px-4 rounded-lg transition text-sm focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
            {{ 'admin.photos.upload_button'|trans }}
        </button>
    </form>
</div>
{% endblock %}
