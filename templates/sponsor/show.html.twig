{% extends 'base.html.twig' %}

{# Die Seite eines Sponsors (Feature 15).

   Zustände: aktiv · ehemalig (ohne Website-Link, AK-21) · ohne Zitat · ohne Website (AK-20).
   Ein Fehlerzustand entsteht hier nicht: Wer nicht zu sehen ist, bekommt im Controller
   die gewöhnliche 404-Seite (AK-22, AK-23).

   ⚠ **Das Zitat bleibt in seiner Sprache** und trägt sie als `lang` (AK-18) — so liest ein
   Screenreader ein französisches Zitat auf der deutschen Seite französisch. Gezeichnet
   ist es mit dem Firmennamen, nie mit einer Person (AK-44).

   ⚠ **Der Website-Link ist ein bezahlter Link** und trägt `rel="sponsored"` (AK-17) —
   Google verlangt die Kennzeichnung. Kein `target`: Er öffnet wie jeder Link. Was die
   Zielseite über die Herkunft erfährt, begrenzt die Referrer-Policy der ganzen Website
   auf den Ursprung (AK-42). Ehemalige verlieren den Link: Er ist nicht mehr bezahlt, und
   eine verfallene Domain gehörte Jahre später womöglich einem Fremden (EC-11).

   Überarbeitung 2026-10-28: „Über <Name>" zeigt die Kurzbeschreibung in der Seitensprache
   (AK-49) — anders als das Zitat übersetzt und vom Sponsor freigegeben. Escaping, dann
   `nl2br` (EC-13), nie `|raw`. Die Profillinks stehen in der Linkzeile neben der Website, als
   Text ohne Plattformsymbol (nichts wird von dort geladen, AK-55), und fehlen wie die
   Website bei ehemaligen Sponsoren (AK-54). #}

{% block title %}{{ sponsor.name }} · {{ 'sponsor.meta_title'|trans }} · Endlech.lu{% endblock %}

{% block meta_description %}
    <meta name="description" content="{{ 'sponsor.meta_description'|trans }}">
{% endblock %}

{% block body %}
    {% set _zeitraeume = include('sponsor/_periods.html.twig', {sponsor: sponsor}) %}

    {# === KOPFBAND ========================================================= #}
    <section class="bg-linear-to-r from-cyan-700 to-purple-800 text-white py-16">
        <div class="container mx-auto px-4 max-w-3xl flex flex-col gap-6 sm:flex-row sm:items-center">
            {# Der Name steht daneben als Überschrift — das Logo ist hier Schmuck (leeres alt). #}
            {{ include('sponsor/_logo.html.twig', {sponsor: sponsor, size: 'lg', link: false, decorative: true}) }}
            <div>
                <h1 class="text-3xl md:text-4xl font-bold leading-tight">{{ sponsor.name }}</h1>
                <p class="mt-2 text-lg text-cyan-50">
                    {% if is_active %}
                        {{ 'sponsor.show.label_active'|trans({'%periods%': _zeitraeume}) }}
                    {% else %}
                        {{ 'sponsor.show.label_former'|trans({'%periods%': _zeitraeume}) }}
                    {% endif %}
                </p>
            </div>
        </div>
    </section>

    <section class="bg-white py-16">
        <div class="container mx-auto px-4 max-w-3xl space-y-10">
            {% set _beschreibung = sponsor.descriptionIn(app.request.locale) %}
            {% if _beschreibung %}
                <div>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">{{ 'sponsor.show.about_title'|trans({'%name%': sponsor.name}) }}</h2>
                    <p class="text-gray-800 leading-relaxed">{{ _beschreibung|nl2br }}</p>
                </div>
            {% endif %}

            {% if sponsor.quote %}
                <div>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">{{ 'sponsor.show.quote_title'|trans }}</h2>
                    <figure class="rounded-xl border-l-4 border-purple-700 bg-gray-50 p-6">
                        <blockquote lang="{{ sponsor.quoteLocale }}" class="text-lg text-gray-900 leading-relaxed">
                            <p>„{{ sponsor.quote }}“</p>
                        </blockquote>
                        <figcaption class="mt-3 text-sm font-semibold text-gray-700">— {{ sponsor.name }}</figcaption>
                    </figure>
                </div>
            {% endif %}

            <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">{{ 'sponsor.usage.title'|trans }}</h2>
                <p class="text-gray-800 leading-relaxed mb-4">{{ 'sponsor.usage.text'|trans }}</p>
                <a href="{{ path('app_open') }}#finance-heading" class="text-cyan-800 underline underline-offset-2 focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">{{ 'sponsor.usage.link'|trans }}</a>
            </div>

            {{ include('sponsor/_not_included.html.twig', {name: sponsor.name}) }}

            {% set _profile = is_active ? sponsor.profileLinks : [] %}
            {% if is_active and (sponsor.website or _profile is not empty) %}
                <ul class="flex flex-wrap gap-3">
                    {% if sponsor.website %}
                        <li>
                            <a href="{{ sponsor.website }}" rel="sponsored noopener"
                               class="inline-flex items-center gap-2 min-h-[48px] rounded-full border-2 border-gray-900 px-6 py-2 font-semibold text-gray-900 hover:bg-gray-900 hover:text-white motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
                                {{ 'sponsor.show.website'|trans({'%name%': sponsor.name}) }}
                                <span aria-hidden="true">↗</span>
                            </a>
                        </li>
                    {% endif %}
                    {% for profil in _profile %}
                        <li>
                            {# Sichtbar der Plattformname, angesagt „Instagram von <Name>" — der sichtbare
                               Text steckt im Namen (WCAG 2.5.3). #}
                            <a href="{{ profil.url }}" rel="sponsored noopener"
                               aria-label="{{ 'sponsor.show.profile_label'|trans({'%platform%': profil.platform.label, '%name%': sponsor.name}) }}"
                               class="inline-flex items-center gap-2 min-h-[48px] rounded-full border-2 border-gray-300 px-6 py-2 font-semibold text-gray-900 hover:border-gray-900 motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
                                {{- profil.platform.label -}}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-gray-200 pt-6">
                <a href="{{ path('app_organisations_type', {slug: 'unternehmen'}) }}#anfrage"
                   class="inline-block min-h-[48px] bg-purple-700 hover:bg-purple-800 text-white font-bold px-8 py-3 rounded-full shadow-md motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
                    {{ 'sponsor.become'|trans }}
                </a>
                <a href="{{ path('app_sponsor_index') }}" class="text-cyan-800 underline underline-offset-2 focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">{{ 'sponsor.all'|trans }}</a>
            </div>
        </div>
    </section>
{% endblock %}
