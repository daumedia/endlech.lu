{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}

    {# === HERO SECTION === #}
    <section class="bg-linear-to-r from-cyan-600 to-purple-700 text-white py-20 shadow-md">
        <div class="container mx-auto px-4 text-center">
            <span class="inline-block bg-white/20 text-white text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
                {{ 'home.hero.badge'|trans({'%count%': totalCount}) }}
            </span>
            <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">
                {{ 'home.hero.heading'|trans }}
            </h1>
            <p class="text-cyan-100 text-lg md:text-xl max-w-2xl mx-auto mb-8">
                {{ 'home.hero.subtitle'|trans }}
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="{{ path('app_restaurant_index') }}" class="inline-flex items-center justify-center min-h-[48px] bg-white text-purple-700 font-bold px-8 py-3 rounded-full shadow-lg hover:shadow-xl motion-safe:transition motion-safe:transform motion-safe:hover:-translate-y-0.5 focus:outline-2 focus:outline-offset-2 focus:outline-white">
                    {{ 'home.hero.cta_discover'|trans }}
                </a>
                <a href="{{ path('app_register') }}" class="inline-flex items-center justify-center min-h-[48px] border-2 border-white text-white font-bold px-8 py-3 rounded-full hover:bg-white/10 motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-white">
                    {{ 'home.hero.cta_join'|trans }}
                </a>
            </div>
        </div>
    </section>

    {# === SO FUNKTIONIERT'S === #}
    <section class="bg-white py-16">
        <div class="container mx-auto px-4">
            <h2 class="text-2xl md:text-3xl font-bold text-center text-gray-800 mb-12">{{ 'home.how_it_works.title'|trans }}</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">

                {# Schritt 1: Suchen #}
                <div class="text-center">
                    <div class="w-16 h-16 bg-cyan-50 text-cyan-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </div>
                    <h3 class="font-bold text-lg text-gray-800 mb-2">{{ 'home.how_it_works.search_title'|trans }}</h3>
                    <p class="text-gray-500 text-sm">{{ 'home.how_it_works.search_text'|trans }}</p>
                </div>

                {# Schritt 2: Informieren #}
                <div class="text-center">
                    <div class="w-16 h-16 bg-purple-50 text-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <h3 class="font-bold text-lg text-gray-800 mb-2">{{ 'home.how_it_works.inform_title'|trans }}</h3>
                    <p class="text-gray-500 text-sm">{{ 'home.how_it_works.inform_text'|trans }}</p>
                </div>

                {# Schritt 3: Bewerten #}
                <div class="text-center">
                    <div class="w-16 h-16 bg-cyan-50 text-cyan-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                        </svg>
                    </div>
                    <h3 class="font-bold text-lg text-gray-800 mb-2">{{ 'home.how_it_works.rate_title'|trans }}</h3>
                    <p class="text-gray-500 text-sm">{{ 'home.how_it_works.rate_text'|trans }}</p>
                </div>

            </div>
        </div>
    </section>

    {# === TOP BEWERTETE RESTAURANTS === #}
    <section class="bg-gray-50 py-16">
        <div class="container mx-auto px-4">
            <div class="text-center mb-10">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-2">{{ 'home.top_rated.title'|trans }}</h2>
                <p class="text-gray-500">{{ 'home.top_rated.subtitle'|trans }}</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
                {% for restaurant in restaurants %}
                    <article class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md motion-safe:transition group flex flex-col">
                        <div class="h-36 bg-gray-100 relative {{ restaurant.coverImage is null ? 'flex items-center justify-center text-gray-300 text-5xl' : '' }}">
                            {% if restaurant.coverImage %}
                                <img src="/uploads/restaurants/{{ restaurant.coverImage.filename }}"
                                     alt="{{ restaurant.coverImage.altText ?: restaurant.name }}"
                                     class="w-full h-full object-cover">
                            {% else %}
                                <span aria-hidden="true">{{ restaurant.emoji }}</span>
                            {% endif %}
                            {% if restaurant|is_open_now %}
                                <span class="absolute top-3 right-3 bg-green-700 text-white text-xs font-bold px-2 py-1 rounded shadow-sm">{{ 'status.open'|trans }}</span>
                            {% else %}
                                <span class="absolute top-3 right-3 bg-red-700 text-white text-xs font-bold px-2 py-1 rounded shadow-sm">{{ 'status.closed'|trans }}</span>
                            {% endif %}
                        </div>
                        <div class="p-5 flex-grow">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="text-lg font-bold text-gray-900 group-hover:text-purple-700 motion-safe:transition">{{ restaurant.name }}</h3>
                                    <p class="text-sm text-gray-500">{{ restaurant.city }}{% if restaurant.cuisineNames %} &bull; {{ restaurant.cuisineNames }}{% endif %}</p>
                                </div>
                                {% if restaurant.rating is not null %}
                                    <div class="bg-cyan-50 text-cyan-700 px-2 py-1 rounded text-xs font-bold border border-cyan-100 shrink-0">{{ restaurant.rating }}</div>
                                {% endif %}
                            </div>

                            {# Barrierefreiheits-Icons #}
                            <div class="flex gap-2 mt-3 flex-wrap">
                                {% if restaurant.isWheelchairAccessible %}
                                    <span title="{{ 'accessibility.wheelchair'|trans }}" class="text-sm bg-green-50 text-green-700 px-2 py-0.5 rounded border border-green-100">♿</span>
                                {% endif %}
                                {% if restaurant.hasAccessibleToilet %}
                                    <span title="{{ 'accessibility.toilet'|trans }}" class="text-sm bg-green-50 text-green-700 px-2 py-0.5 rounded border border-green-100">🚻</span>
                                {% endif %}
                                {% if restaurant.allowsAssistanceDogs %}
                                    <span title="{{ 'accessibility.dogs'|trans }}" class="text-sm bg-green-50 text-green-700 px-2 py-0.5 rounded border border-green-100">🐕</span>
                                {% endif %}
                                {% if restaurant.hasBrightLighting %}
                                    <span title="{{ 'accessibility.lighting'|trans }}" class="text-sm bg-green-50 text-green-700 px-2 py-0.5 rounded border border-green-100">💡</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="px-5 py-3 bg-gray-50 border-t border-gray-100 mt-auto">
                            <a href="{{ path('app_restaurant_show', {id: restaurant.id}) }}" class="block text-center text-sm font-semibold text-purple-600 hover:text-purple-800 py-1 rounded focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">{{ 'home.view_details'|trans }}</a>
                        </div>
                    </article>
                {% else %}
                    <div class="col-span-3 text-center py-12 text-gray-500">
                        <p class="text-lg">{{ 'home.no_restaurants'|trans }}</p>
                    </div>
                {% endfor %}
            </div>

            <div class="text-center mt-10">
                <a href="{{ path('app_restaurant_index') }}" class="inline-flex items-center justify-center min-h-[48px] bg-purple-600 hover:bg-purple-700 text-white font-bold px-8 py-3 rounded-full shadow-md hover:shadow-lg motion-safe:transition motion-safe:transform motion-safe:hover:-translate-y-0.5 focus:outline-2 focus:outline-offset-2 focus:outline-purple-700">
                    {{ 'home.view_all'|trans }}
                </a>
            </div>
        </div>
    </section>

    {# === WARUM ENDLECH.LU? === #}
    <section class="bg-white py-16">
        <div class="container mx-auto px-4">
            <h2 class="text-2xl md:text-3xl font-bold text-center text-gray-800 mb-12">{{ 'home.why.title'|trans }}</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">

                <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
                    <div class="w-12 h-12 bg-cyan-100 text-cyan-600 rounded-xl flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </div>
                    <h3 class="font-bold text-gray-800 mb-2">{{ 'home.why.community_title'|trans }}</h3>
                    <p class="text-sm text-gray-500">{{ 'home.why.community_text'|trans }}</p>
                </div>

                <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
                    <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                        </svg>
                    </div>
                    <h3 class="font-bold text-gray-800 mb-2">{{ 'home.why.criteria_title'|trans }}</h3>
                    <p class="text-sm text-gray-500">{{ 'home.why.criteria_text'|trans }}</p>
                </div>

                <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
                    <div class="w-12 h-12 bg-cyan-100 text-cyan-600 rounded-xl flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <h3 class="font-bold text-gray-800 mb-2">{{ 'home.why.luxembourg_title'|trans }}</h3>
                    <p class="text-sm text-gray-500">{{ 'home.why.luxembourg_text'|trans }}</p>
                </div>

            </div>
        </div>
    </section>

    {# === HINWEISBAND: APP-WARTELISTE (Feature 08) ===
       Bewusst ein ruhiger Streifen und kein zweiter Hero: Der Handlungsaufruf
       darunter ist der der Seite, dieses Band ist ein Hinweis daneben.
       bg-gray-50, weil die Sektion darüber weiß ist — zwei gleiche Flächen
       dürfen nicht aneinanderstoßen.
       ⚠ KEIN Store-Abzeichen. Es gibt keine veröffentlichte App; ein „Im App
       Store laden" wäre ein Versprechen ohne Deckung (Nicht im Scope). #}
    <section class="bg-gray-50 border-y border-gray-200 py-10" aria-labelledby="home-app-heading">
        <div class="container mx-auto px-4 max-w-4xl flex flex-col gap-6 md:flex-row md:items-center">
            <p class="w-12 h-12 shrink-0 bg-cyan-50 rounded-2xl flex items-center justify-center text-3xl" aria-hidden="true">📱</p>

            <div class="grow">
                <h2 id="home-app-heading" class="text-xl md:text-2xl font-bold text-gray-800">{{ 'home.app.heading'|trans }}</h2>
                <p class="mt-1 text-sm text-gray-600">{{ 'home.app.text'|trans }}</p>
            </div>

            <a href="{{ path('app_app_waitlist') }}"
               class="inline-flex items-center justify-center min-h-[48px] shrink-0 bg-cyan-700 hover:bg-cyan-800 text-white font-bold px-6 py-3 rounded-full shadow-sm hover:shadow-md motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
                {{ 'home.app.cta'|trans }}
            </a>
        </div>
    </section>

    {# === CTA BANNER === #}
    <section class="bg-linear-to-r from-purple-700 to-cyan-600 py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">{{ 'home.cta.heading'|trans }}</h2>
            <p class="text-purple-100 text-lg mb-8 max-w-xl mx-auto">{{ 'home.cta.text'|trans }}</p>
            <a href="{{ path('app_register') }}" class="inline-flex items-center justify-center min-h-[48px] bg-white text-purple-700 font-bold px-8 py-3 rounded-full shadow-lg hover:shadow-xl motion-safe:transition motion-safe:transform motion-safe:hover:-translate-y-0.5 focus:outline-2 focus:outline-offset-2 focus:outline-white">
                {{ 'home.cta.button'|trans }}
            </a>
        </div>
    </section>

{% endblock %}
