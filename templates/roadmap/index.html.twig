{% extends 'base.html.twig' %}

{#
    Die öffentliche Roadmap (Feature 07).

    ⚠ **Nirgends ein Datum, ein Quartal oder eine Fortschrittsangabe** (AK-06).
    Das ist keine Auslassung, sondern die Zusage aus Decision Log 5: Ein gerissener
    Termin kostet mehr Glaubwürdigkeit, als eine Zahl einbringt. `RoadmapItem`
    trägt deshalb gar kein Datumsfeld — was es nicht gibt, kann kein Template
    versehentlich rendern.

    ⚠ **Jede Spalte ist eine eigene <section> mit eigener <h2>** (AK-37). Die
    Zugehörigkeit eines Eintrags darf sich nicht allein aus seiner Position
    ergeben — im Screenreader gibt es keine Spalten, nur eine Reihenfolge.

    ⚠ **Seit Feature 16 kommt der Kopf aus `roadmap/_area_header.html.twig`** — Name
    „Roadmap & Ideen", Knopf „Idee einreichen", drei Reiter. Er ist bewusst niedrig:
    Die Spalte „In Arbeit" soll auf einem Gerät mit 800 px Höhe ohne Scrollen sichtbar
    sein (07/AK-03, 16/AK-11). Der frühere Block „Weiterlesen" ist entfallen; die Reiter
    führen in einem Klick zu Changelog und Ideen (07/AK-10 → 16/AK-07).
#}

{% block title %}{{ 'meta_title'|trans({}, 'roadmap') }}{% endblock %}

{% block meta_description %}
    <meta name="description" content="{{ 'meta_description'|trans({}, 'roadmap') }}">
{% endblock %}

{% block body %}
    {# === BEREICHSKOPF (Feature 16) ======================================= #}
    {% include 'roadmap/_area_header.html.twig' with {
        active: 'roadmap',
        heading: 'heading'|trans({}, 'roadmap'),
        intro: 'intro'|trans({}, 'roadmap'),
    } only %}

    {# === SPALTEN ========================================================== #}
    <section class="bg-white py-10 md:py-14">
        <div class="container mx-auto px-4">
            <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                <p class="max-w-2xl text-sm text-gray-600">{{ 'no_dates_hint'|trans({}, 'roadmap') }}</p>
                {% include 'partials/_freshness.html.twig' with {'lastChange': lastChange} only %}
            </div>

            <div class="grid gap-6 md:grid-cols-3 md:items-start">
                {% for column in columns %}
                    {% set stage = column.stage %}
                    {% set showCommunity = stage == plannedStage and community.ideas|length > 0 %}
                    <section aria-labelledby="stage-{{ stage.value }}" class="rounded-2xl bg-gray-50 p-5">
                        <h2 id="stage-{{ stage.value }}" class="mb-4 flex items-center gap-2 text-lg font-bold text-gray-900">
                            <span aria-hidden="true">{{ stage.emoji }}</span>
                            {{ stage.transKey|trans({}, 'roadmap') }}
                        </h2>

                        {% if column.items is empty and not showCommunity %}
                            {# Leerer Zustand: ein erklärender Satz, keine leere Fläche (AK-09). #}
                            <p class="text-sm text-gray-600">{{ stage.emptyKey|trans({}, 'roadmap') }}</p>
                        {% else %}
                            {% if column.items is not empty %}
                                <ul class="space-y-3">
                                    {% for item in column.items %}
                                        {% include 'roadmap/_item.html.twig' with {'item': item, 'level': 3} only %}
                                    {% endfor %}
                                </ul>
                            {% endif %}

                            {% if showCommunity %}
                                <div class="mt-6 border-t border-gray-200 pt-5">
                                    <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-gray-700">{{ 'community.heading'|trans({}, 'roadmap') }}</h3>
                                    {#
                                        ⚠ Der Hinweis steht IMMER, auch bei weniger als zehn Ideen
                                        (AK-52, OF-06). Er erklärt nicht nur die Auswahl — er ist die
                                        Aufforderung, im Board zuzustimmen.
                                    #}
                                    <p class="mb-3 text-sm text-gray-600">{{ 'community.selection_hint'|trans({}, 'roadmap') }}</p>
                                    <ul class="space-y-3">
                                        {% for idea in community.ideas %}
                                            {% include 'roadmap/_item.html.twig' with {'idea': idea, 'level': 4} only %}
                                        {% endfor %}
                                    </ul>
                                    {% if community.more > 0 %}
                                        {# Führt auf den Reiter Ideen, gefiltert auf „Geplant" (16/AK-16) —
                                           vorher stand der Verweis aufs Board im Block „Weiterlesen". #}
                                        <p class="mt-3 text-sm">
                                            <a href="{{ path('app_board_index', {status: 'planned'}) }}"
                                               class="inline-flex items-center min-h-[44px] font-semibold text-cyan-700 hover:text-cyan-800 hover:underline motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-600">
                                                {{- 'community.more'|trans({'%count%': community.more}, 'roadmap') -}}
                                                <span aria-hidden="true" class="ml-1">→</span>
                                            </a>
                                        </p>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endif %}
                    </section>
                {% endfor %}
            </div>
        </div>
    </section>

    {# === BEWUSST NICHT GEBAUT ============================================= #}
    {#
        ⚠ Eigene Überschrift auf abgesetzter Fläche, deutlich getrennt von den drei
        Spalten (AK-08). Ohne Vorwissen muss erkennbar sein, dass diese Punkte NICHT
        kommen — stünden sie unter derselben Überschrift wie die Spalten, läse sich
        der Block wie eine vierte Stufe der Zusage.
    #}
    <section class="bg-gray-100 py-12 md:py-16" aria-labelledby="shelved-heading">
        <div class="container mx-auto px-4">
            <h2 id="shelved-heading" class="mb-2 text-2xl font-bold text-gray-900">{{ 'shelved.section_title'|trans({}, 'roadmap') }}</h2>
            <p class="mb-6 max-w-2xl text-gray-600">{{ 'shelved.section_intro'|trans({}, 'roadmap') }}</p>

            <ul class="grid gap-4 md:grid-cols-2">
                {% for item in shelved %}
                    <li class="rounded-xl border border-gray-200 bg-white/70 p-4">
                        <h3 class="font-semibold text-gray-700 wrap-anywhere">{{ item.titleKey|trans({}, 'roadmap') }}</h3>
                        <p class="mt-2 text-sm text-gray-600 leading-relaxed">{{ item.reasonKey|trans({}, 'roadmap') }}</p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

{% endblock %}
