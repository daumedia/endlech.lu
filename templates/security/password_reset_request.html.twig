{% extends 'base.html.twig' %}

{% block title %}{{ 'password_reset.request_title'|trans }} – Endlech.lu{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-16 max-w-md">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
        <h1 class="text-2xl font-bold text-gray-900 mb-2">{{ 'password_reset.request_title'|trans }}</h1>
        <p class="text-gray-600 mb-6 leading-relaxed">{{ 'password_reset.request_intro'|trans }}</p>

        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {{ include('partials/_form_field.html.twig', {field: form.email}) }}

            <button type="submit"
                    class="w-full min-h-[48px] mt-4 bg-cyan-700 hover:bg-cyan-800 text-white font-bold py-3 rounded-full shadow-md hover:shadow-lg motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
                {{ 'password_reset.request_action'|trans }}
            </button>
        {{ form_end(form) }}

        <p class="text-sm text-gray-500 mt-6 text-center">
            <a href="{{ path('app_login') }}" class="underline hover:text-cyan-700">{{ 'password_reset.back_to_login'|trans }}</a>
        </p>
    </div>
</div>
{% endblock %}
