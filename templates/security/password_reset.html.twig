{% extends 'base.html.twig' %}

{% block title %}{{ 'password_reset.title'|trans }} – Endlech.lu{% endblock %}

{#
    Drei Zustände in einer Vorlage — dasselbe Muster wie bei den Wartelisten
    (_waitlist_confirmation.html.twig): Ein unbekannter oder abgelaufener Link
    darf nie in einem Fehler enden, sondern muss sagen, was zu tun ist.
#}
{% block body %}
<div class="container mx-auto px-4 py-16 max-w-md">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">

        {% if state == 'form' %}
            <h1 class="text-2xl font-bold text-gray-900 mb-2">{{ 'password_reset.title'|trans }}</h1>
            <p class="text-gray-600 mb-6 leading-relaxed">{{ 'password_reset.intro'|trans }}</p>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                {{ include('partials/_form_field.html.twig', {field: form.plainPassword.first}) }}
                {{ include('partials/_form_field.html.twig', {field: form.plainPassword.second}) }}

                <button type="submit"
                        class="w-full min-h-[48px] mt-4 bg-cyan-700 hover:bg-cyan-800 text-white font-bold py-3 rounded-full shadow-md hover:shadow-lg motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
                    {{ 'password_reset.action'|trans }}
                </button>
            {{ form_end(form) }}

        {% else %}
            {% set emoji = state == 'expired' ? '⌛' : '🔗' %}
            <p class="text-5xl mb-4 text-center" aria-hidden="true">{{ emoji }}</p>
            <h1 class="text-2xl font-bold text-gray-900 mb-3 text-center">
                {{ ('password_reset.' ~ state ~ '_heading')|trans }}
            </h1>
            <p class="text-gray-800 leading-relaxed text-center">
                {{ ('password_reset.' ~ state ~ '_text')|trans }}
            </p>

            <a href="{{ path('app_password_reset_request') }}"
               class="block text-center mt-6 min-h-[48px] bg-cyan-700 hover:bg-cyan-800 text-white font-bold px-8 py-3 rounded-full shadow-md hover:shadow-lg motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
                {{ 'password_reset.request_new'|trans }}
            </a>
        {% endif %}
    </div>
</div>
{% endblock %}
