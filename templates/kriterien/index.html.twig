{% extends 'base.html.twig' %}

{% block title %}{{ 'criteria.title'|trans }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">{{ 'criteria.heading'|trans }}</h1>
    <p class="text-gray-600 mb-10 text-lg">
        {{ 'criteria.intro'|trans }}
    </p>

    <div class="space-y-6">

        {# Eingang #}
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
            <div class="flex items-start gap-4">
                <div class="text-3xl">🚪</div>
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-1">{{ 'criteria.entrance_title'|trans }}</h2>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        {{ 'criteria.entrance_text'|trans }}
                    </p>
                </div>
            </div>
        </div>

        {# Parkplatz #}
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
            <div class="flex items-start gap-4">
                <div class="text-3xl">🅿️</div>
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-1">{{ 'criteria.parking_title'|trans }}</h2>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        {{ 'criteria.parking_text'|trans }}
                    </p>
                </div>
            </div>
        </div>

        {# WC #}
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
            <div class="flex items-start gap-4">
                <div class="text-3xl">🚻</div>
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-1">{{ 'criteria.toilet_title'|trans }}</h2>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        {{ 'criteria.toilet_text'|trans }}
                    </p>
                </div>
            </div>
        </div>

        {# Rollstuhl im Innenbereich #}
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
            <div class="flex items-start gap-4">
                <div class="text-3xl">♿</div>
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-1">{{ 'criteria.interior_title'|trans }}</h2>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        {{ 'criteria.interior_text'|trans }}
                    </p>
                </div>
            </div>
        </div>

        {# Personal #}
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
            <div class="flex items-start gap-4">
                <div class="text-3xl">🙋</div>
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-1">{{ 'criteria.staff_title'|trans }}</h2>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        {{ 'criteria.staff_text'|trans }}
                    </p>
                </div>
            </div>
        </div>

        {# Speisekarte #}
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
            <div class="flex items-start gap-4">
                <div class="text-3xl">📋</div>
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-1">{{ 'criteria.menu_title'|trans }}</h2>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        {{ 'criteria.menu_text'|trans }}
                    </p>
                </div>
            </div>
        </div>

    </div>

    {# ⚠ BF-66: Die Seite listete sechs Kriterien, während /open und der CC-BY-
       Datensatz eine Punktzahl aus ACHT Merkmalen veröffentlichen. Wer diese Zahl
       sieht — auf der Transparenzseite, im Datensatz, in einem Fördergespräch —
       muss wissen, was sie misst. Die Seite, die genau dafür da ist, sagte es
       nicht. Besonders der letzte Satz zählt: Nicht erfasst wirkt wie nicht
       erfüllt, und das erklärt, warum ein neu erfasstes Haus die
       Durchschnittspunktzahl senkt (BF-67). #}
    <div class="mt-12 bg-white border border-gray-200 rounded-xl p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-2">{{ 'criteria.score_title'|trans }}</h2>
        <p class="text-gray-600 text-sm leading-relaxed mb-4">{{ 'criteria.score_intro'|trans }}</p>

        <ul class="grid gap-2 sm:grid-cols-2 text-sm text-gray-700 mb-4">
            {% for merkmal in [
                'criteria.score_wheelchair', 'criteria.score_toilet',
                'criteria.score_dogs', 'criteria.score_lighting',
                'criteria.score_changing_table', 'criteria.score_parking',
                'criteria.score_door_width', 'criteria.score_table_spacing'
            ] %}
                <li class="flex items-start gap-2">
                    <span class="text-cyan-600" aria-hidden="true">•</span>
                    {{ merkmal|trans }}
                </li>
            {% endfor %}
        </ul>

        <p class="text-gray-800 text-sm leading-relaxed font-medium">{{ 'criteria.score_unmeasured'|trans }}</p>
        <p class="text-gray-600 text-sm leading-relaxed mt-2">
            {{ 'criteria.score_where'|trans }}
            <a href="{{ path('app_open') }}" class="text-cyan-700 hover:underline">{{ 'criteria.score_open_link'|trans }}</a>.
        </p>
    </div>

    <div class="mt-6 bg-cyan-50 border border-cyan-200 rounded-xl p-6">
        <p class="text-cyan-800 text-sm leading-relaxed">
            <strong>{{ 'criteria.note_label'|trans }}</strong> {{ 'criteria.note_text'|trans }}
        </p>
    </div>
</div>
{% endblock %}
