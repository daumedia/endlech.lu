{# Freigegebene Zitate.

   Der Hinweis unter der Überschrift ist eine Zusage an die Redaktion: Diese Sätze
   dürfen ohne Rückfrage übernommen werden. Wer ein Zitat ergänzt, holt vorher die
   Freigabe der zitierten Person ein — sonst steht die Zusage für etwas, das sie
   nicht deckt. #}
<section id="zitate" class="bg-white py-16 scroll-mt-24" aria-labelledby="zitate-titel">
    <div class="container mx-auto px-4 max-w-3xl">
        <h2 id="zitate-titel" class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">{{ 'quotes.section_title'|trans({}, 'press') }}</h2>
        <p class="text-gray-700 leading-relaxed mb-8">{{ 'quotes.release_note'|trans({}, 'press') }}</p>

        <div class="space-y-6">
            {% for zitat in quotes %}
                <figure class="rounded-xl border-l-4 border-cyan-700 bg-gray-50 p-6">
                    <blockquote class="text-lg leading-relaxed text-gray-900">„{{ zitat.textKey|trans({}, 'press') }}"</blockquote>
                    <figcaption class="mt-3 text-sm text-gray-700">
                        <span class="font-semibold text-gray-900">{{ zitat.personName }}</span>,
                        {{ zitat.roleKey|trans({}, 'press') }}
                    </figcaption>
                </figure>
            {% endfor %}
        </div>
    </div>
</section>
