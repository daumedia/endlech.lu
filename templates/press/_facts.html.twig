{# Faktenblatt.

   ⚠ Eine Beschreibungsliste und keine Tabelle. Eine Tabelle bräuchte bei 320 px
   einen fokussierbaren Scrollbereich (das Muster von /partner); eine Liste, die
   untereinander bricht, erfüllt AK-33 ohne Zusatzmechanik.

   ⚠ Die drei Zahlen kommen aus derselben Quelle wie /open — nicht aus dem
   Katalog. Eine feste Zahl im Text veraltet still, und eine veraltete Zahl in
   einem Zeitungsartikel ist nicht mehr einzufangen.

   ⚠ Betreiber, Anschrift und Verantwortlicher stehen als Parameter und werden
   hier und im Impressum aus derselben Stelle gelesen (AK-15). Solange sie leer
   sind (VB-03), steht dort der Hinweis `facts.pending` — nicht die halbe
   Wahrheit. #}
<section id="fakten" class="bg-gray-50 py-16 scroll-mt-24" aria-labelledby="fakten-titel">
    <div class="container mx-auto px-4 max-w-3xl">
        <h2 id="fakten-titel" class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">{{ 'facts.section_title'|trans({}, 'press') }}</h2>
        <p class="text-gray-700 leading-relaxed mb-8">{{ 'facts.section_intro'|trans({}, 'press') }}</p>

        <ul class="grid gap-4 sm:grid-cols-3 mb-10">
            <li class="rounded-xl border-2 border-gray-300 bg-white p-5">
                <p class="text-3xl font-bold text-gray-900 tabular-nums">{{ facts.restaurants|format_number }}</p>
                <p class="text-sm text-gray-700 mt-1">{{ 'facts.figure_restaurants'|trans({}, 'press') }}</p>
            </li>
            <li class="rounded-xl border-2 border-gray-300 bg-white p-5">
                <p class="text-3xl font-bold text-gray-900 tabular-nums">{{ facts.verified|format_number }}</p>
                <p class="text-sm text-gray-700 mt-1">{{ 'facts.figure_verified'|trans({}, 'press') }}</p>
            </li>
            <li class="rounded-xl border-2 border-gray-300 bg-white p-5">
                <p class="text-3xl font-bold text-gray-900 tabular-nums">{{ facts.communesCovered|format_number }}</p>
                <p class="text-sm text-gray-700 mt-1">
                    {{ 'facts.figure_communes'|trans({}, 'press') }}
                    <span class="text-gray-600">{{ 'facts.figure_communes_suffix'|trans({'%total%': facts.totalCommunes|format_number}, 'press') }}</span>
                </p>
            </li>
        </ul>

        <p class="text-sm text-gray-700 mb-8">
            {{ 'facts.source_note'|trans({}, 'press') }}
            <a href="{{ path('app_open') }}" class="text-cyan-800 underline underline-offset-2 focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">{{ 'facts.source_link'|trans({}, 'press') }}</a>
        </p>

        <dl class="rounded-xl border-2 border-gray-300 bg-white divide-y divide-gray-200">
            {# ⚠ Die Anschrift steht in der Liste `optional` und wird **weggelassen**, wenn
               sie leer ist — anders als Betreiber und Verantwortlicher, die dann den
               Ausstehend-Hinweis tragen. Entschieden am 2026-08-30 (OF-04): Es wird keine
               Anschrift veröffentlicht, erreichbar ist der Betreiber über den
               Pressekontakt. Eine Zeile „Anschrift" mit einer Mailadresse darin wäre keine
               Angabe, sondern eine Lücke im Gewand einer Angabe. Kommt später eine c/o-
               oder Postfachadresse, erscheint die Zeile ohne weiteren Eingriff. #}
            {% for eintrag in [
                {'label': 'facts.operator', 'wert': operator_name, 'optional': false},
                {'label': 'facts.address', 'wert': operator_address, 'optional': true},
                {'label': 'facts.responsible', 'wert': operator_responsible, 'optional': false}
            ] %}
                {% if eintrag.wert is not empty or not eintrag.optional %}
                    <div class="flex flex-col gap-1 p-5 sm:flex-row sm:gap-6">
                        <dt class="font-semibold text-gray-900 sm:w-1/3">{{ eintrag.label|trans({}, 'press') }}</dt>
                        <dd class="text-gray-800 sm:w-2/3">
                            {%- if eintrag.wert is not empty -%}
                                {{ eintrag.wert|nl2br }}
                            {%- else -%}
                                <span class="text-gray-600 italic">{{ 'facts.pending'|trans({}, 'press') }}</span>
                            {%- endif -%}
                        </dd>
                    </div>
                {% endif %}
            {% endfor %}
            {% for eintrag in [
                {'label': 'facts.country', 'wert': 'facts.country_value'},
                {'label': 'facts.founded', 'wert': 'facts.founded_value'},
                {'label': 'facts.status', 'wert': 'facts.status_value'},
                {'label': 'facts.license_code', 'wert': 'facts.license_code_value'},
                {'label': 'facts.license_data', 'wert': 'facts.license_data_value'},
                {'label': 'facts.languages', 'wert': 'facts.languages_value'}
            ] %}
                <div class="flex flex-col gap-1 p-5 sm:flex-row sm:gap-6">
                    <dt class="font-semibold text-gray-900 sm:w-1/3">{{ eintrag.label|trans({}, 'press') }}</dt>
                    <dd class="text-gray-800 sm:w-2/3">{{ eintrag.wert|trans({}, 'press') }}</dd>
                </div>
            {% endfor %}
            <div class="flex flex-col gap-1 p-5 sm:flex-row sm:gap-6">
                <dt class="font-semibold text-gray-900 sm:w-1/3">{{ 'facts.contact'|trans({}, 'press') }}</dt>
                <dd class="text-gray-800 sm:w-2/3">
                    <a href="mailto:{{ press_email }}" class="text-cyan-800 underline underline-offset-2 break-all focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">{{ press_email }}</a>
                </dd>
            </div>
        </dl>
    </div>
</section>
