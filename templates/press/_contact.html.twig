{# Pressekontakt.

   Kein Formular: Ein Formular hieße Rate Limit, Honeypot und Speicherung — für
   eine Handvoll Anfragen im Jahr viel Mechanik, und die Adresse steht ohnehin im
   Faktenblatt. Der mailto-Link läuft im Mailprogramm des Besuchers und ist damit
   kein Dienstaufruf: Es geht keine Verbindung zu einem Dritten hinaus. #}
<section id="kontakt" class="bg-white py-16 scroll-mt-24" aria-labelledby="kontakt-titel">
    <div class="container mx-auto px-4 max-w-3xl">
        <h2 id="kontakt-titel" class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">{{ 'contact.section_title'|trans({}, 'press') }}</h2>

        <div class="rounded-xl border-2 border-gray-300 bg-gray-50 p-6">
            <p class="mb-4">
                <span class="sr-only">{{ 'contact.email_label'|trans({}, 'press') }}:</span>
                <a href="mailto:{{ press_email }}"
                   class="inline-flex items-center min-h-[48px] text-lg font-bold text-cyan-800 underline underline-offset-4 break-all focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">{{ press_email }}</a>
            </p>
            <p class="text-gray-800 leading-relaxed">{{ 'contact.response_time'|trans({}, 'press') }}</p>
            <p class="text-gray-800 leading-relaxed mt-2">{{ 'contact.interview'|trans({}, 'press') }}</p>
        </div>
    </div>
</section>
