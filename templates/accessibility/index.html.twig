{% extends 'base.html.twig' %}

{% block title %}{{ 'accessibility_statement.meta_title'|trans }}{% endblock %}

{% block body %}
    {# Hero – dunkle Stufe wie die übrigen Geschäfts-/Datenseiten. #}
    <div class="bg-linear-to-r from-cyan-700 to-purple-800 text-white">
        <div class="container mx-auto px-4 py-16 max-w-3xl">
            <h1 class="text-3xl md:text-5xl font-bold mb-5 leading-tight">{{ 'accessibility_statement.hero_heading'|trans }}</h1>
            <p class="text-cyan-100 text-lg md:text-xl max-w-2xl">{{ 'accessibility_statement.hero_lead'|trans }}</p>
        </div>
    </div>

    <div class="container mx-auto px-4 py-16 max-w-3xl">

        {# Konformität #}
        <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">{{ 'accessibility_statement.conformance_heading'|trans }}</h2>

            {% if outdated %}
                <p class="bg-amber-50 border border-amber-200 text-amber-900 rounded-lg p-4 mb-4" role="status">
                    {{ 'accessibility_statement.outdated_notice'|trans({'%months%': review_interval_months}) }}
                </p>
            {% endif %}

            <p class="text-gray-800 leading-relaxed">
                {%- if conformance_level == 'full' -%}
                    {{ 'accessibility_statement.conformance_full'|trans({'%standard%': 'accessibility_statement.standard'|trans}) }}
                {%- elseif conformance_level == 'partial' -%}
                    {{ 'accessibility_statement.conformance_partial'|trans({'%standard%': 'accessibility_statement.standard'|trans}) }}
                {%- else -%}
                    {{ 'accessibility_statement.conformance_none'|trans }}
                {%- endif -%}
            </p>

            {% if tested_on %}
                <p class="text-gray-500 text-sm mt-2">{{ 'accessibility_statement.tested_on_label'|trans }}: {{ tested_on|date('d.m.Y') }}</p>
            {% else %}
                <p class="text-gray-500 text-sm mt-2">{{ 'accessibility_statement.not_yet_tested'|trans }}</p>
            {% endif %}
        </section>

        {# Prüfverfahren #}
        <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">{{ 'accessibility_statement.procedure_heading'|trans }}</h2>
            <p class="text-gray-800 leading-relaxed">{{ 'accessibility_statement.procedure_text'|trans }}</p>
        </section>

        {# Geltungsbereich #}
        <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">{{ 'accessibility_statement.scope_heading'|trans }}</h2>
            <p class="text-gray-800 leading-relaxed">{{ 'accessibility_statement.scope_text'|trans }}</p>
        </section>

        {# Nicht barrierefreie Inhalte #}
        <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">{{ 'accessibility_statement.issues_heading'|trans }}</h2>
            {% if known_issues is empty %}
                <p class="text-gray-800 leading-relaxed">{{ 'accessibility_statement.issues_none'|trans }}</p>
            {% else %}
                <ul class="space-y-4">
                    {% for issue in known_issues %}
                        <li class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                            <p class="font-semibold text-gray-900">{{ 'accessibility_statement.issue_criterion'|trans }}: {{ issue.criterion }}</p>
                            <p class="text-gray-700 mt-1">{{ 'accessibility_statement.issue_reason'|trans }}: {{ issue.reason }}</p>
                            {% if issue.planned is defined and issue.planned %}
                                <p class="text-gray-500 text-sm mt-1">{{ 'accessibility_statement.issue_planned'|trans }}: {{ issue.planned }}</p>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {# Rechtslage #}
        <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">{{ 'accessibility_statement.legal_heading'|trans }}</h2>
            <p class="text-gray-800 leading-relaxed">{{ 'accessibility_statement.legal_text'|trans }}</p>
        </section>

        {# Rückmeldeweg: Formular UND Kontaktadresse im Klartext (AK-48). #}
        <section>
            <h2 class="text-2xl font-bold text-gray-800 mb-6">{{ 'accessibility_statement.feedback_heading'|trans }}</h2>
            <p class="text-gray-800 leading-relaxed mb-2">{{ 'accessibility_statement.feedback_intro'|trans }}</p>
            <p class="text-gray-800 mb-8">
                {{ 'accessibility_statement.contact_label'|trans }}
                <a href="mailto:info@endlech.lu" class="text-cyan-700 font-semibold underline hover:text-cyan-800">info@endlech.lu</a>
            </p>

            <div id="accessibility-report-form">
                {% include 'accessibility/_form.html.twig' with {form: form} %}
            </div>
        </section>
    </div>
{% endblock %}
