{# Erfolgsmeldung nach dem Absenden. Trägt dieselbe id wie das Formular, damit
   der Turbo-Stream sie an dessen Stelle setzt. tabindex/-1 + autofocus holen den
   Fokus hierher, role=status sagt sie dem Screenreader an (AK-51). #}
<div id="accessibility-report-form"
     tabindex="-1"
     autofocus
     role="status"
     class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
    <p class="text-3xl mb-2" aria-hidden="true">✓</p>
    <h3 class="text-lg font-bold text-gray-900 mb-1">{{ 'accessibility_statement.report_success_heading'|trans }}</h3>
    <p class="text-gray-700">{{ 'accessibility_statement.report_success_text'|trans }}</p>
</div>
