{#
    Aktualitätshinweis für Roadmap und Changelog (Feature 07, AK-27, AK-28).

    Parameter:
      lastChange – DateTimeImmutable|null, Datum des jüngsten GEZEIGTEN
                   Changelog-Eintrags. Ein stilles Release zählt nicht: Für den
                   Besucher ist es nicht passiert und darf die Seite nicht frisch
                   aussehen lassen.

    ⚠ Regel und Klassen sind von /open übernommen, nicht neu erfunden — dort steht
    seit Feature B16 dieselbe 60-Tage-Schwelle für die Finanzzahlen. Eine Seite,
    der man das Alter nicht ansieht, richtet mehr Schaden an als gar keine.

    ⚠ Geteiltes Partial für BEIDE Seiten des Features. Zwei Fassungen derselben
    Regel wären zwei Stellen, an denen sie auseinanderläuft.

    Die Schlüssel liegen in der Domain `roadmap` — auch für die Changelog-Seite.
#}
{% set staleDays = lastChange ? date().diff(date(lastChange)).days : null %}
{% set isStale = staleDays is not null and staleDays > 60 %}

<p class="text-xs {{ isStale ? 'inline-flex items-start gap-2 rounded-lg bg-amber-50 border border-amber-200 text-amber-900 px-3 py-2' : 'text-gray-500' }}">
    {% if isStale %}<span aria-hidden="true">⚠️</span>{% endif %}
    <span>
        {% if lastChange is null %}
            {{ 'freshness.never'|trans({}, 'roadmap') }}
        {% elseif isStale %}
            {{ 'freshness.stale'|trans({'%date%': lastChange|format_date('long'), '%days%': staleDays}, 'roadmap') }}
        {% else %}
            {{ 'freshness.label'|trans({'%date%': lastChange|format_date('long')}, 'roadmap') }}
        {% endif %}
    </span>
</p>
