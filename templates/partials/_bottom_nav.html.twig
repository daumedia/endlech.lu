{# === MOBILE BOTTOM-NAVIGATION (Issue #83) ===
   Nur auf Mobil sichtbar (md:hidden). Ersetzt die auf kleinen Screens
   ausgeblendete Header-Navigation. Tap-Targets >= 44px, Safe-Area unten. #}
{% set _route = app.request.attributes.get('_route') %}
{% set _items = [
    { route: 'app_home',             active: ['app_home'],                              label: 'nav.home',        href: path('app_home') },
    { route: 'app_restaurant_index', active: ['app_restaurant_index', 'app_restaurant_show'], label: 'nav.restaurants', href: path('app_restaurant_index') },
    { route: 'app_about',            active: ['app_about'],                             label: 'nav.about',       href: path('app_about') },
    app.user
        ? { route: 'app_profile', active: ['app_profile'], label: 'nav.profile', href: path('app_profile') }
        : { route: 'app_login',   active: ['app_login'],   label: 'nav.login',   href: path('app_login') }
] %}

<nav class="fixed bottom-0 inset-x-0 z-50 md:hidden bg-white border-t border-gray-200 shadow-[0_-1px_3px_rgba(0,0,0,0.08)] pb-[env(safe-area-inset-bottom)]"
     aria-label="{{ 'nav.bottom_navigation'|trans }}">
    <ul class="grid grid-cols-4">
        {% for item in _items %}
            {% set is_active = _route in item.active %}
            <li>
                <a href="{{ item.href }}"
                   class="flex flex-col items-center justify-center gap-1 min-h-[44px] py-2 text-xs font-medium transition {{ is_active ? 'text-cyan-600' : 'text-gray-500 hover:text-cyan-600' }}"
                   {{ is_active ? 'aria-current="page"' : '' }}>
                    <span class="w-6 h-6" aria-hidden="true">
                        {% if item.route == 'app_home' %}
                            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"/></svg>
                        {% elseif item.route == 'app_restaurant_index' %}
                            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 11.25l1.5 1.5.75-.75V8.758c0-.555-.368-1.05-.91-1.174a19.5 19.5 0 00-8.68 0c-.542.124-.91.62-.91 1.174v3.242l.75.75 1.5-1.5M15 11.25v8.25a1.5 1.5 0 01-3 0V15a1.5 1.5 0 00-3 0v4.5a1.5 1.5 0 01-3 0v-8.25"/></svg>
                        {% elseif item.route == 'app_about' %}
                            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
                        {% else %}
                            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                        {% endif %}
                    </span>
                    <span>{{ item.label|trans }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
</nav>
