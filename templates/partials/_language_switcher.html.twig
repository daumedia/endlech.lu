{# Language Switcher für öffentliche Seiten #}
{% set current_locale = app.request.locale %}
{% set current_route = app.request.attributes.get('_route') %}
{% set current_params = app.request.attributes.get('_route_params', {}) %}
{# BF-68: `_locale` aus dem Query fernhalten UND die Sprache zuletzt mergen.
   Beides ist nötig. Nur die Reihenfolge zu tauschen repariert den Umschalter,
   ließe aber `?_locale=` als Query-Parameter stehen — die nächste Stelle, die
   Query-Parameter durchreicht, hätte dasselbe Problem.
   Vorher erzeugte `?_locale=//fremd.example/de` ein `href="///fremd.example/…"`,
   und der Browser navigierte auf den fremden Host. #}
{% set query_params = app.request.query.all()|filter((wert, schluessel) => schluessel != '_locale') %}

{# Aus `framework.enabled_locales` — eine eigene Liste hier lief beim Hinzufügen von pt
   Gefahr, die neue Sprache im Umschalter zu vergessen. #}
{% set locales = {} %}
{% for _locale_code in app.enabled_locales %}
    {% set locales = locales|merge({(_locale_code): _locale_code|upper}) %}
{% endfor %}

{# ⚠ BF-144: `min-h-[44px]` unter `md`. Gemessen war der Knopf auf dem Telefon
   55 × 28 px — das kleinste Ziel im mobilen Kopfbereich, und seit BF-72 ist er
   ausdrücklich für Mobil gedacht. WCAG 2.5.8 (24 × 24 px) war erfüllt, die Projektregel
   für Aktionen nicht. Ab `md` bleibt es bei der kompakten Form: Dort zeigt der Kopf
   ohnehin mehr, und der Platz ist knapp (BF-80). #}
<div class="relative" data-controller="language-switcher"
     data-action="keydown.esc->language-switcher#closeOnEscape">
    <button
        type="button"
        class="flex items-center gap-1.5 text-sm font-medium text-gray-600 hover:text-cyan-600 transition px-2 py-2.5 md:py-1 min-h-[44px] md:min-h-0 rounded-md hover:bg-gray-100"
        data-action="click->language-switcher#toggle"
        data-language-switcher-target="button"
        aria-expanded="false"
        aria-haspopup="true"
    >
        <span class="uppercase">{{ current_locale }}</span>
        <svg class="w-3.5 h-3.5 transition-transform" data-language-switcher-target="arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </button>

    <div
        class="absolute right-0 mt-1 w-28 bg-white rounded-lg shadow-lg border border-gray-200 py-1 z-50 hidden"
        data-language-switcher-target="menu"
        data-action="click@window->language-switcher#close"
    >
        {% for locale, label in locales %}
            {% if locale != current_locale %}
                <a
                    href="{{ path(current_route, current_params|merge(query_params)|merge({'_locale': locale})) }}"
                    class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-cyan-600 transition"
                >
                    {{ label }}
                </a>
            {% else %}
                <span class="block px-4 py-2 text-sm font-semibold text-cyan-600">
                    {{ label }}
                </span>
            {% endif %}
        {% endfor %}
    </div>
</div>
