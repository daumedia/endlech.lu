{#
    Erfolgsmeldung nach dem Absenden einer Warteliste – geteilt von Partner-
    und Organisations-Formular.

    Parameter:
      target_id – id des Elements, das der Turbo-Stream ersetzt; muss mit der
                  id des Formular-Wrappers übereinstimmen
      title     – bereits übersetzte Überschrift
      text      – bereits übersetzter Fließtext
      hint      – optionaler, bereits übersetzter Zusatzhinweis
      emoji     – optionales Emoji (Default 📬)

    tabindex="-1" + autofocus: Nach dem Austausch wandert der Fokus hierher –
    ohne das bliebe er am verschwundenen Absenden-Button hängen und
    Screenreader-Nutzer bekämen vom Erfolg nichts mit.
#}
<div id="{{ target_id }}" tabindex="-1" autofocus role="status"
     class="rounded-2xl border-2 border-green-700 bg-green-50 p-8 text-center">
    <p class="text-4xl mb-3" aria-hidden="true">{{ emoji|default('📬') }}</p>

    <h3 class="text-xl font-bold text-gray-900 mb-2">{{ title }}</h3>

    <p class="text-gray-800 leading-relaxed">{{ text }}</p>

    {% if hint is defined and hint %}
        <p class="mt-4 text-sm text-gray-700">{{ hint }}</p>
    {% endif %}
</div>
