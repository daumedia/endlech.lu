{% extends 'email/base.html.twig' %}

{% block title %}{{ 'email.password_reset_title'|trans }}{% endblock %}

{% block body %}
    <h2 style="margin: 0 0 16px; color: #111827; font-size: 20px; font-weight: 700;">
        {{ 'email.password_reset_greeting'|trans({'%name%': user.name}) }}
    </h2>

    <p style="margin: 0 0 24px; color: #6b7280; font-size: 14px; line-height: 1.6;">
        {{ 'email.password_reset_text'|trans }}
    </p>

    <p style="margin: 0 0 24px;">
        <a href="{{ resetUrl }}"
           style="display:inline-block;background:#0891b2;color:#ffffff;font-weight:700;padding:12px 28px;border-radius:9999px;text-decoration:none;">
            {{ 'email.password_reset_cta'|trans }}
        </a>
    </p>

    <p style="margin: 0 0 8px; color: #6b7280; font-size: 13px; line-height: 1.6;">
        {{ 'email.password_reset_expiry'|trans }}
    </p>
    <p style="margin: 0; color: #6b7280; font-size: 13px; line-height: 1.6;">
        {{ 'email.password_reset_ignore'|trans }}
    </p>
{% endblock %}
