{% extends 'base.html.twig' %}

{% block title %}{{ 'board.title'|trans }} · Endlech.lu{% endblock %}

{% block body %}
<div class="bg-gradient-to-br from-cyan-700 to-purple-800 text-white">
    <div class="max-w-4xl mx-auto px-4 py-12 sm:py-16">
        <h1 class="text-3xl sm:text-4xl font-bold">{{ 'board.title'|trans }}</h1>
        <p class="mt-3 text-cyan-50 max-w-2xl">{{ 'board.intro'|trans }}</p>

        {# Genau EINE Leitzahl je Seite (Design-System). #}
        <p class="mt-6 text-4xl sm:text-5xl font-bold">{{ total }}</p>
        <p class="text-cyan-100 text-sm">{{ 'board.lead_label'|trans }}</p>

        <a href="{{ path('app_board_new') }}"
           class="mt-6 inline-flex items-center min-h-[48px] px-6 rounded-lg bg-white text-cyan-800 font-semibold focus:outline-2 focus:outline-offset-2 motion-safe:transition hover:bg-cyan-50">
            {{ 'board.submit_cta'|trans }}
        </a>
    </div>
</div>

<div class="max-w-4xl mx-auto px-4 py-8">

    {# Steuerleiste als GET-Formular: wirkt ohne JavaScript (AK-49). #}
    <form method="get" class="flex flex-wrap items-end gap-4 mb-6">
        <div>
            <label for="sort" class="block text-sm font-medium text-gray-700">{{ 'board.sort_label'|trans }}</label>
            <select name="sort" id="sort" class="mt-1 min-h-[48px] rounded-lg border border-gray-300 px-3 focus:outline-2 focus:outline-offset-2">
                <option value="votes" {{ sort == 'votes' ? 'selected' }}>{{ 'board.sort_votes'|trans }}</option>
                <option value="newest" {{ sort == 'newest' ? 'selected' }}>{{ 'board.sort_newest'|trans }}</option>
            </select>
        </div>
        <div>
            <label for="status" class="block text-sm font-medium text-gray-700">{{ 'board.filter_label'|trans }}</label>
            <select name="status" id="status" class="mt-1 min-h-[48px] rounded-lg border border-gray-300 px-3 focus:outline-2 focus:outline-offset-2">
                <option value="">{{ 'board.filter_all'|trans }}</option>
                {% for fall in ['new', 'reviewing', 'planned', 'declined'] %}
                    <option value="{{ fall }}" {{ status and status.value == fall ? 'selected' }}>{{ ('board.status_' ~ fall)|trans }}</option>
                {% endfor %}
            </select>
        </div>
        <button type="submit" class="min-h-[48px] px-5 rounded-lg bg-cyan-700 text-white font-semibold focus:outline-2 focus:outline-offset-2 motion-safe:transition hover:bg-cyan-800">
            {{ 'board.filter_apply'|trans }}
        </button>
    </form>

    {% if ideas is empty %}
        {# Leerer Zustand — der erste, den ein neuer Besucher sieht (AK-08). #}
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-8 text-center">
            <p class="text-4xl" aria-hidden="true">💡</p>
            <h2 class="mt-3 text-xl font-bold text-gray-900">{{ 'board.empty_title'|trans }}</h2>
            <p class="mt-2 text-gray-600 max-w-md mx-auto">{{ 'board.empty_text'|trans }}</p>
            <a href="{{ path('app_board_new') }}"
               class="mt-6 inline-flex items-center min-h-[48px] px-6 rounded-lg bg-cyan-700 text-white font-semibold focus:outline-2 focus:outline-offset-2 motion-safe:transition hover:bg-cyan-800">
                {{ 'board.submit_cta'|trans }}
            </a>
        </div>
    {% else %}
        <div class="space-y-4">
            {% for idea in ideas %}
                {% include 'partials/_board_idea_card.html.twig' with {
                    idea: idea,
                    voteCount: voteCounts[idea.id]|default(0),
                    hasVoted: idea.id in votedIds,
                    authorName: authorName,
                    excerpt: true,
                } only %}
            {% endfor %}
        </div>

        {% if lastPage > 1 %}
            <nav class="mt-8 flex items-center justify-between gap-4" aria-label="{{ 'pagination.page_of'|trans({'%current%': currentPage, '%last%': lastPage}) }}">
                {% if currentPage > 1 %}
                    <a href="{{ path('app_board_index', {sort: sort, status: status ? status.value : null, page: currentPage - 1}) }}"
                       class="min-h-[48px] inline-flex items-center px-4 rounded-lg border border-gray-300 focus:outline-2 focus:outline-offset-2">← {{ 'pagination.previous'|trans }}</a>
                {% else %}<span></span>{% endif %}

                <span class="text-sm text-gray-600">{{ 'pagination.page_of'|trans({'%current%': currentPage, '%last%': lastPage}) }}</span>

                {% if currentPage < lastPage %}
                    <a href="{{ path('app_board_index', {sort: sort, status: status ? status.value : null, page: currentPage + 1}) }}"
                       class="min-h-[48px] inline-flex items-center px-4 rounded-lg border border-gray-300 focus:outline-2 focus:outline-offset-2">{{ 'pagination.next'|trans }} →</a>
                {% else %}<span></span>{% endif %}
            </nav>
        {% endif %}
    {% endif %}

    {# Eigener Abschnitt statt eines Filters (AK-75): Der Beleg, dass zugehört
       wird, ist die Wirkung des Boards — er gehört sichtbar auf dieselbe Seite,
       nur nicht in die Liste der offenen Wünsche. #}
    {% if done is not empty %}
        <section class="mt-12 pt-8 border-t border-gray-200">
            <h2 class="text-xl font-bold text-gray-900">{{ 'board.done_title'|trans }}</h2>
            <p class="mt-1 text-gray-600">{{ 'board.done_intro'|trans }}</p>
            <div class="mt-4 space-y-4">
                {% for idea in done %}
                    {% include 'partials/_board_idea_card.html.twig' with {
                        idea: idea,
                        voteCount: voteCounts[idea.id]|default(0),
                        hasVoted: idea.id in votedIds,
                        authorName: authorName,
                        excerpt: true,
                    } only %}
                {% endfor %}
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
