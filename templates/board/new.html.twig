{% extends 'base.html.twig' %}

{% block title %}{{ 'board.submit_cta'|trans }} · Endlech.lu{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 py-8">
    <a href="{{ path('app_board_index') }}"
       class="inline-flex items-center min-h-[48px] text-cyan-700 hover:text-cyan-900 focus:outline-2 focus:outline-offset-2">
        ← {{ 'board.back_to_board'|trans }}
    </a>

    <h1 class="mt-4 text-2xl sm:text-3xl font-bold text-gray-900">{{ 'board.submit_cta'|trans }}</h1>

    {# ⚠ Der Hinweisblock steht VOR dem Absendeknopf (AK-16) und nennt die
       Bearbeitungszeit (AK-72). Der Freitext ist der erste öffentlich
       veröffentlichte des Projekts — wer hier eine Gesundheitsangabe
       hineinschreibt, veröffentlicht sie. #}
    <div class="mt-4 rounded-xl bg-cyan-50 border border-cyan-200 p-4 text-sm text-cyan-950 space-y-2">
        <p>{{ 'board.notice_public'|trans }}</p>
        <p class="font-semibold">{{ 'board.notice_no_health'|trans }}</p>
        <p>{{ 'board.notice_time'|trans }}</p>
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'mt-6 space-y-5'}}) }}
        {% include 'partials/_form_field.html.twig' with {
            field: form.title,
            help: 'board.form_title_help'|trans,
            autofocus: form.title.vars.errors|length > 0,
        } only %}

        {% include 'partials/_form_field.html.twig' with {
            field: form.description,
            help: 'board.form_description_help'|trans,
            rows: 8,
            autofocus: form.title.vars.errors|length == 0 and form.description.vars.errors|length > 0,
        } only %}

        {# Fallenfeld: per CSS aus dem Blickfeld, nicht type="hidden" (AK-17). #}
        <div style="position:absolute; left:-9999px;" aria-hidden="true">
            {{ form_row(form.website, {label: 'board.form_honeypot'|trans}) }}
        </div>

        <button type="submit"
                class="min-h-[48px] px-6 rounded-lg bg-cyan-700 text-white font-semibold focus:outline-2 focus:outline-offset-2 motion-safe:transition hover:bg-cyan-800">
            {{ 'board.form_submit'|trans }}
        </button>
    {{ form_end(form) }}
</div>
{% endblock %}
