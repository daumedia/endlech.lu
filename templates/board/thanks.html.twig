{% extends 'base.html.twig' %}

{% block title %}{{ 'board.thanks_title'|trans }} · Endlech.lu{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 py-16 text-center">
    <p class="text-5xl" aria-hidden="true">✅</p>
    <h1 class="mt-4 text-2xl sm:text-3xl font-bold text-gray-900" tabindex="-1" autofocus role="status">
        {{ 'board.thanks_title'|trans }}
    </h1>
    <p class="mt-3 text-gray-600">{{ 'board.thanks_text'|trans }}</p>

    {# Dieselbe Zusage wie am Formular — an beiden Stellen (AK-72). #}
    <p class="mt-4 text-sm text-gray-500">{{ 'board.notice_time'|trans }}</p>

    <a href="{{ path('app_board_index') }}"
       class="mt-8 inline-flex items-center min-h-[48px] px-6 rounded-lg bg-cyan-700 text-white font-semibold focus:outline-2 focus:outline-offset-2 motion-safe:transition hover:bg-cyan-800">
        {{ 'board.back_to_board'|trans }}
    </a>
</div>
{% endblock %}
