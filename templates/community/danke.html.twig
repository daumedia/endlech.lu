{% extends 'base.html.twig' %}

{% block title %}{{ 'community.thanks.title'|trans }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-20 max-w-xl text-center">

    <div class="text-7xl mb-6" aria-hidden="true">🎉</div>
    <h1 class="text-3xl font-bold text-gray-900 mb-4">{{ 'community.thanks.heading'|trans }}</h1>
    <p class="text-gray-700 text-lg mb-8">
        {{ 'community.thanks.text'|trans }}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="{{ path('community_vorschlagen') }}"
           class="min-h-[48px] inline-flex items-center justify-center bg-cyan-600 hover:bg-cyan-700 text-white font-bold px-6 py-3 rounded-full shadow-md hover:shadow-lg motion-safe:transition motion-safe:hover:-translate-y-0.5 focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
            {{ 'community.thanks.suggest_another'|trans }}
        </a>
        <a href="{{ path('app_restaurant_index') }}"
           class="min-h-[48px] inline-flex items-center justify-center bg-white hover:bg-gray-50 text-gray-700 font-bold px-6 py-3 rounded-full border border-gray-500 shadow-sm hover:shadow-md motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-gray-700">
            {{ 'community.thanks.discover'|trans }}
        </a>
    </div>

</div>
{% endblock %}
