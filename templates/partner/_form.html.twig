{#
    Wartelisten-Formular. Die id ist zugleich das Ziel des Turbo-Streams –
    partner/_success.html.twig trägt dieselbe id, damit der Austausch sauber greift.

    Das erste fehlerhafte Feld bekommt autofocus: So springt der Fokus auch ohne
    JavaScript dorthin (der Browser fokussiert [autofocus] beim Rendern der
    422-Antwort; Turbo tut nach einem Render dasselbe). Muster der
    Fehler-Ermittlung wie in community/vorschlagen.html.twig.

    form_start bekommt bewusst KEIN action: So postet das Formular auf die
    aktuelle URL inklusive Query-String – nur dadurch überlebt ?utm_source=…
    den Absendevorgang und landet in der Attribution.
#}
{% set field_order = ['restaurantName', 'contactName', 'email', 'phone', 'locality', 'message', 'consent'] %}
{% set first_error_field = null %}
{% set error_count = form.vars.errors|length %}
{% for name in field_order %}
    {% if first_error_field is null and form[name].vars.errors|length > 0 %}
        {% set first_error_field = name %}
    {% endif %}
    {% set error_count = error_count + form[name].vars.errors|length %}
{% endfor %}

<div id="partner-waitlist-form">
    {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

        {# Live-Region: immer im DOM, damit eine spätere Einfügung als Update
           gemeldet wird. Tragend ist aber der Fokussprung – das fokussierte
           Feld trägt seine Meldung über aria-describedby. #}
        <div aria-live="polite" role="status">
            {% if error_count > 0 %}
                <div class="border-l-4 border-red-700 bg-red-50 px-4 py-3 rounded-r-lg">
                    <p class="text-sm font-bold text-red-800">
                        {{ 'partner.form.error_summary'|trans({'%count%': error_count}) }}
                    </p>
                    {% if form.vars.errors|length > 0 %}
                        <ul class="mt-2 text-sm text-red-800 list-disc list-inside">
                            {% for error in form.vars.errors %}
                                <li>{{ error.message }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {{ include('partials/_form_field.html.twig', {
                field: form.restaurantName,
                autofocus: first_error_field == 'restaurantName'
            }) }}
            {{ include('partials/_form_field.html.twig', {
                field: form.contactName,
                autofocus: first_error_field == 'contactName'
            }) }}
            {{ include('partials/_form_field.html.twig', {
                field: form.email,
                help: 'partner.form.email_help'|trans,
                autofocus: first_error_field == 'email'
            }) }}
            {{ include('partials/_form_field.html.twig', {
                field: form.phone,
                autofocus: first_error_field == 'phone'
            }) }}
        </div>

        {{ include('partials/_form_field.html.twig', {
            field: form.locality,
            help: 'partner.form.locality_help'|trans,
            autofocus: first_error_field == 'locality'
        }) }}

        {{ include('partials/_form_field.html.twig', {
            field: form.message, rows: 4,
            help: 'partner.form.message_help'|trans,
            autofocus: first_error_field == 'message'
        }) }}

        {# Honeypot: für Menschen unsichtbar, für Screenreader und Tastatur
           ausgeblendet – nur Bots füllen ihn aus. aria-hidden und tabindex="-1"
           gehören zusammen: ein fokussierbares aria-hidden-Element wäre ein
           ARIA-Verstoß. Kein display:none, das überspringen manche Bots gezielt. #}
        <div aria-hidden="true" class="absolute w-px h-px -left-[9999px] overflow-hidden">
            {{ form_label(form.website) }}
            {{ form_widget(form.website) }}
        </div>

        {# Einwilligung: unangehakt per Default (CheckboxType-Standard), Zweck
           ausformuliert. Der Datenschutz-Link steht bewusst NEBEN dem Label und
           nicht darin – ein Link im Label würde beim Klick die Checkbox togglen. #}
        <div class="rounded-xl border border-gray-300 bg-gray-50 p-4 space-y-2">
            <div class="flex items-start gap-3">
                {{ form_widget(form.consent, {'attr': {
                    'class': 'mt-0.5 w-5 h-5 shrink-0 rounded border-gray-500 text-cyan-700 focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700',
                    'aria-describedby': form.consent.vars.id ~ '_error',
                    'aria-invalid': form.consent.vars.errors|length > 0 ? 'true' : false,
                }}) }}
                {{ form_label(form.consent, null, {'label_attr': {'class': 'text-sm text-gray-900 leading-relaxed cursor-pointer'}}) }}
            </div>

            <p id="{{ form.consent.vars.id }}_error" class="text-sm font-semibold text-red-700">
                {%- for error in form.consent.vars.errors %}{{ error.message }}{% endfor -%}
            </p>

            <p class="text-xs text-gray-700">
                {{ 'partner.form.privacy_note'|trans }}
                <a href="{{ path('app_impressum') }}#datenschutz"
                   class="font-semibold text-cyan-800 underline rounded focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
                    {{ 'partner.form.privacy_link'|trans }}
                </a>
            </p>
        </div>

        <button type="submit"
                class="w-full md:w-auto min-h-[48px] bg-cyan-700 hover:bg-cyan-800 text-white font-bold px-8 py-3 rounded-full shadow-md hover:shadow-lg motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700 cursor-pointer">
            {{ 'partner.form.submit'|trans }}
        </button>

    {{ form_end(form) }}
</div>
