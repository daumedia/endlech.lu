{#
    Integritätsblock – steht auf der Übersicht und auf jeder Unterseite.

    Bewusst überall: Das Versprechen, dass Bewertungen nicht käuflich sind, ist
    für alle drei Zielgruppen dasselbe und darf auf keiner Einstiegsseite fehlen.
#}
<section class="bg-linear-to-r from-cyan-700 to-purple-800 text-white py-16">
    <div class="container mx-auto px-4 max-w-3xl">
        <p class="inline-block bg-white/20 text-white text-sm font-semibold px-4 py-1.5 rounded-full mb-5">
            {{ 'organisation.integrity.badge'|trans }}
        </p>

        <h2 class="text-2xl md:text-3xl font-bold mb-4">{{ 'organisation.integrity.heading'|trans }}</h2>
        <p class="text-lg text-cyan-50 leading-relaxed mb-6">{{ 'organisation.integrity.text'|trans }}</p>

        <ul class="space-y-3">
            {% for i in 1..3 %}
                <li class="flex items-start gap-3">
                    <span class="text-xl leading-none mt-0.5" aria-hidden="true">✓</span>
                    <span class="leading-relaxed">{{ ('organisation.integrity.point_' ~ i)|trans }}</span>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
