{% extends 'base.html.twig' %}

{% block title %}{{ ('organisation.' ~ type.value ~ '.title')|trans }} – Endlech.lu{% endblock %}

{#
    Eigene Seite je Zielgruppe (/organisationen/{slug}).

    Der Inhalt kommt aus demselben Partial, das auch die Übersicht kannte –
    einmal gepflegt, an einer Stelle. Das Formular steht darunter mit bereits
    gewähltem Typ; der Selektor bleibt sichtbar, damit jemand, der auf der
    falschen Seite gelandet ist, ohne Umweg wechseln kann.
#}
{% block body %}

{# === HERO =============================================================== #}
<section class="bg-linear-to-r from-cyan-700 to-purple-800 text-white py-16">
    <div class="container mx-auto px-4 max-w-3xl">
        <nav aria-label="{{ 'organisation.breadcrumb'|trans }}" class="mb-5 text-sm text-cyan-50">
            <a href="{{ path('app_organisations') }}"
               class="underline hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded">
                {{ 'organisation.breadcrumb_root'|trans }}
            </a>
            <span aria-hidden="true" class="mx-2">/</span>
            <span>{{ type.transKey|trans }}</span>
        </nav>

        <p class="text-5xl mb-4" aria-hidden="true">{{ type.emoji }}</p>

        <h1 class="text-3xl md:text-4xl font-bold mb-4 leading-tight">
            {{ ('organisation.' ~ type.value ~ '.title')|trans }}
        </h1>

        <p class="text-lg text-cyan-50 leading-relaxed">
            {{ ('organisation.' ~ type.value ~ '.intro')|trans }}
        </p>
    </div>
</section>

{# === INHALT ============================================================= #}
<section class="bg-white py-16">
    <div class="container mx-auto px-4 max-w-3xl">
        {{ include('organisation/_section_' ~ type.value ~ '.html.twig', {heading_level: 'h2'}) }}
    </div>
</section>

{{ include('organisation/_integrity.html.twig') }}

{# === FORMULAR =========================================================== #}
<section id="anfrage" class="bg-gray-50 py-16 scroll-mt-24">
    <div class="container mx-auto px-4 max-w-2xl">
        <h2 class="text-2xl md:text-3xl font-bold text-center text-gray-900 mb-3">{{ 'organisation.form.title'|trans }}</h2>
        <p class="text-center text-gray-700 mb-8">{{ 'organisation.form.subtitle'|trans }}</p>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
            {{ include('organisation/_form.html.twig', {form: form, types: types}) }}
        </div>
    </div>
</section>

{% endblock %}
