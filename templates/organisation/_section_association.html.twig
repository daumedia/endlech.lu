{#
    Inhalt der Sektion „Organisationen und Vereine".

    Wird an zwei Stellen eingebunden: als Block auf der Übersichtsseite und als
    Hauptinhalt der eigenen Unterseite (/organisationen/{slug}). Deshalb steht
    hier kein <section>-Rahmen – Hintergrund und Abstände bestimmt die
    einbettende Seite.

    Die Überschriftenebene kommt von der einbettenden Seite (heading_level): Auf
    der eigenen Unterseite steht die Sektion direkt unter dem <h1> und braucht
    dort <h2>, sonst übersprünge die Seite eine Ebene.
#}
{% set hl = heading_level|default('h2') %}
    <{{ hl }} class="text-lg font-bold text-gray-900 mb-3">{{ 'organisation.association.decides_title'|trans }}</{{ hl }}>
    <ul class="space-y-2 mb-8">
        {% for i in 1..3 %}
            <li class="flex items-start gap-3 text-gray-800">
                <span class="text-teal-800 mt-0.5" aria-hidden="true">✓</span>
                <span>{{ ('organisation.association.decides_' ~ i)|trans }}</span>
            </li>
        {% endfor %}
    </ul>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div class="rounded-xl border border-gray-300 bg-white p-4">
            <p class="font-semibold text-gray-900 mb-1">{{ 'organisation.association.meetings_title'|trans }}</p>
            <p class="text-sm text-gray-700 leading-relaxed">{{ 'organisation.association.meetings_text'|trans }}</p>
        </div>
        <div class="rounded-xl border border-gray-300 bg-white p-4">
            <p class="font-semibold text-gray-900 mb-1">{{ 'organisation.association.public_title'|trans }}</p>
            <p class="text-sm text-gray-700 leading-relaxed">{{ 'organisation.association.public_text'|trans }}</p>
        </div>
    </div>

    {# Kein Verkaufskanal – das muss unmissverständlich dastehen. #}
    <div class="rounded-xl border-2 border-teal-700 bg-teal-50 p-5 mb-6">
        <{{ hl }} class="text-lg font-bold text-teal-900 mb-2">{{ 'organisation.association.no_money_title'|trans }}</{{ hl }}>
        <p class="text-teal-950 leading-relaxed">{{ 'organisation.association.no_money_text'|trans }}</p>
    </div>

    <a href="#anfrage"
       class="inline-block min-h-[48px] bg-teal-800 hover:bg-teal-900 text-white font-bold px-8 py-3 rounded-full shadow-md hover:shadow-lg motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-teal-800">
        {{ 'organisation.association.cta'|trans }}
    </a>
