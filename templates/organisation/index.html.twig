{% extends 'base.html.twig' %}

{% block title %}{{ 'organisation.meta_title'|trans }} – Endlech.lu{% endblock %}

{#
    Übersichtsseite. Sie führt in die drei Bereiche ein und verlinkt auf die
    jeweilige Unterseite – die ausführlichen Inhalte stehen dort, nicht hier
    (sonst stünde derselbe Text doppelt im Netz).

    Das Formular bleibt trotzdem auf dieser Seite, mit freier Typwahl: Wer schon
    weiß, was er will, soll nicht erst eine Unterseite ansteuern müssen.
#}
{% block body %}

{# === HERO =============================================================== #}
<section class="bg-linear-to-r from-cyan-700 to-purple-800 text-white py-20">
    <div class="container mx-auto px-4 max-w-3xl text-center">
        <p class="inline-block bg-white/20 text-white text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
            {{ 'organisation.hero.eyebrow'|trans }}
        </p>

        <h1 class="text-3xl md:text-5xl font-bold mb-5 leading-tight">
            {{ 'organisation.hero.heading'|trans }}
        </h1>

        <p class="text-lg text-cyan-50 leading-relaxed">
            {{ 'organisation.hero.text'|trans }}
        </p>
    </div>
</section>

{# === BEREICHE =========================================================== #}
<section class="bg-white py-16">
    <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-center text-gray-900 mb-3">
            {{ 'organisation.selector.title'|trans }}
        </h2>
        <p class="text-center text-gray-700 mb-10">{{ 'organisation.selector.subtitle'|trans }}</p>

        <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
            {% for type in types %}
                <li>
                    <a href="{{ path('app_organisations_type', {slug: type.slug}) }}"
                       class="flex h-full flex-col rounded-xl border-2 border-gray-300 bg-white p-6 text-center motion-safe:transition hover:border-cyan-700 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-700">
                        <span class="text-4xl mb-3" aria-hidden="true">{{ type.emoji }}</span>
                        <span class="text-lg font-bold text-gray-900 mb-2">{{ type.transKey|trans }}</span>
                        <span class="text-sm text-gray-700 leading-relaxed mb-4">
                            {{ ('organisation.selector.' ~ type.value)|trans }}
                        </span>
                        <span class="mt-auto text-sm font-semibold text-cyan-800">
                            {{ 'organisation.selector.more'|trans }} →
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>

{{ include('organisation/_integrity.html.twig') }}

{# === FORMULAR =========================================================== #}
<section id="anfrage" class="bg-gray-50 py-16 scroll-mt-24">
    <div class="container mx-auto px-4 max-w-2xl">
        <h2 class="text-2xl md:text-3xl font-bold text-center text-gray-900 mb-3">{{ 'organisation.form.title'|trans }}</h2>
        <p class="text-center text-gray-700 mb-8">{{ 'organisation.form.subtitle'|trans }}</p>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
            {{ include('organisation/_form.html.twig', {form: form, types: types}) }}
        </div>
    </div>
</section>

{% endblock %}
