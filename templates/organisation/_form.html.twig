{#
    Wartelisten-Formular für Organisationen. Die id ist zugleich das Ziel des
    Turbo-Streams.

    Ohne JavaScript sind alle drei typspezifischen Blöcke sichtbar und jeweils
    beschriftet – man füllt den passenden aus, PRE_SUBMIT verwirft serverseitig
    die Felder der nicht gewählten Typen. Mit JavaScript blendet der
    Stimulus-Controller die unpassenden Blöcke aus und sagt den Wechsel in einer
    Live-Region an.

    Der Typ-Selektor sind echte Radios in einem <fieldset>: Damit gibt es
    Pfeiltasten-Navigation und Gruppenzugehörigkeit gratis, ohne ARIA-Nachbau.
#}
{# Bei expanded:true ist choice.vars.data der Checked-Zustand (bool), nicht der
   Enum-Case. Deshalb eine Map value → Case, damit Emoji und Label aus dem Enum
   kommen und nicht im Template dupliziert werden. #}
{% set type_map = {} %}
{% for t in types %}{% set type_map = type_map|merge({(t.value): t}) %}{% endfor %}

{% set field_order = ['type', 'organisationName', 'contactName', 'contactRole', 'email', 'phone', 'website', 'message', 'consent'] %}
{% set first_error_field = null %}
{% set error_count = form.vars.errors|length %}
{% for name in field_order %}
    {% if form[name] is defined %}
        {% if first_error_field is null and form[name].vars.errors|length > 0 %}
            {% set first_error_field = name %}
        {% endif %}
        {% set error_count = error_count + form[name].vars.errors|length %}
    {% endif %}
{% endfor %}

<div id="organisation-waitlist-form">
    {{ form_start(form, {'attr': {
        'class': 'space-y-6',
        'novalidate': 'novalidate',
        'data-controller': 'organisation-type',
        'data-organisation-type-announcement-value': 'organisation.form.type_changed'|trans
    }}) }}

        <div aria-live="polite" role="status">
            {% if error_count > 0 %}
                <div class="border-l-4 border-red-700 bg-red-50 px-4 py-3 rounded-r-lg">
                    <p class="text-sm font-bold text-red-800">
                        {{ 'organisation.form.error_summary'|trans({'%count%': error_count}) }}
                    </p>
                    {# Fehler auf Formular-Ebene (z. B. abgelaufener CSRF-Token) haben
                       kein Feld, an dem sie hängen – ohne diese Liste zählte die
                       Meldung sie mit, ohne sie irgendwo zu zeigen. #}
                    {% if form.vars.errors|length > 0 %}
                        <ul class="mt-2 text-sm text-red-800 list-disc list-inside">
                            {% for error in form.vars.errors %}
                                <li>{{ error.message }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {# --- Typ-Auswahl: native Radios, als Karten gestaltet --- #}
        <fieldset>
            <legend class="block mb-1 text-sm font-semibold text-gray-900">
                {{ 'organisation.form.type'|trans }}
            </legend>
            <p class="mb-3 text-xs text-gray-700">{{ 'form.required_field'|trans }}</p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                {% for choice in form.type %}
                    <label class="cursor-pointer">
                        {{ form_widget(choice, {'attr': {
                            'class': 'peer sr-only',
                            'data-action': 'organisation-type#change',
                            'aria-describedby': form.type.vars.id ~ '_error'
                        }}) }}
                        <span class="flex h-full flex-col items-center gap-1 rounded-xl border-2 border-gray-400 bg-white px-4 py-4 text-center motion-safe:transition
                                     peer-checked:border-cyan-700 peer-checked:bg-cyan-50 peer-checked:font-semibold
                                     peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-cyan-700">
                            <span class="text-2xl" aria-hidden="true">{{ type_map[choice.vars.value].emoji }}</span>
                            <span class="text-sm text-gray-900">{{ choice.vars.label|trans }}</span>
                        </span>
                    </label>
                {% endfor %}
            </div>

            <p id="{{ form.type.vars.id }}_error" class="mt-2 text-sm font-semibold text-red-700">
                {%- for error in form.type.vars.errors %}{{ error.message }}{% endfor -%}
            </p>
        </fieldset>

        {# Ansage des Typwechsels für Screenreader. #}
        <p class="sr-only" aria-live="polite" data-organisation-type-target="announcer"></p>

        {# --- Gemeinsame Felder --- #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {{ include('partials/_form_field.html.twig', {
                field: form.organisationName, autofocus: first_error_field == 'organisationName'
            }) }}
            {{ include('partials/_form_field.html.twig', {
                field: form.contactName, autofocus: first_error_field == 'contactName'
            }) }}
            {{ include('partials/_form_field.html.twig', {
                field: form.contactRole,
                help: 'organisation.form.contact_role_help'|trans,
                autofocus: first_error_field == 'contactRole'
            }) }}
            {{ include('partials/_form_field.html.twig', {
                field: form.email, autofocus: first_error_field == 'email'
            }) }}
            {{ include('partials/_form_field.html.twig', {
                field: form.phone, autofocus: first_error_field == 'phone'
            }) }}
            {{ include('partials/_form_field.html.twig', {
                field: form.website, autofocus: first_error_field == 'website'
            }) }}
        </div>

        {# --- Typspezifische Blöcke --- #}
        {% if form.communeName is defined %}
            <div data-organisation-type-target="block" data-type="commune"
                 data-label="{{ 'organisation.type.commune'|trans }}"
                 class="rounded-xl border border-cyan-700 bg-cyan-50/60 p-4 space-y-5">
                <h3 class="text-sm font-bold text-cyan-900">{{ 'organisation.form.block_commune'|trans }}</h3>

                {{ include('partials/_form_field.html.twig', {
                    field: form.communeName, help: 'organisation.form.commune_name_help'|trans
                }) }}
                {{ include('partials/_form_field.html.twig', {
                    field: form.estimatedVenues, help: 'organisation.form.estimated_venues_help'|trans
                }) }}
                {{ include('partials/_form_field.html.twig', {field: form.timeframe}) }}

                {# Datenschutz-Hinweis, der nur Gemeinden betrifft. #}
                <p class="text-xs text-gray-800 border-t border-cyan-700/30 pt-3">
                    {{ 'organisation.form.commune_forwarding_note'|trans }}
                </p>
            </div>
        {% endif %}

        {% if form.sponsorshipInterests is defined %}
            <div data-organisation-type-target="block" data-type="company"
                 data-label="{{ 'organisation.type.company'|trans }}"
                 class="rounded-xl border border-purple-700 bg-purple-50/60 p-4 space-y-3">
                <h3 class="text-sm font-bold text-purple-900">{{ 'organisation.form.block_company'|trans }}</h3>

                <fieldset>
                    <legend class="text-sm font-semibold text-gray-900 mb-2">
                        {{ 'organisation.form.sponsorship_interests'|trans }}
                    </legend>
                    <div class="space-y-2">
                        {% for choice in form.sponsorshipInterests %}
                            <label class="flex items-start gap-3 cursor-pointer">
                                {{ form_widget(choice, {'attr': {'class': 'mt-0.5 w-5 h-5 shrink-0 rounded border-gray-500 text-purple-700 focus:outline-2 focus:outline-offset-2 focus:outline-purple-700'}}) }}
                                <span class="text-sm text-gray-900">{{ choice.vars.label|trans }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
            </div>
        {% endif %}

        {% if form.collaborationInterests is defined %}
            <div data-organisation-type-target="block" data-type="association"
                 data-label="{{ 'organisation.type.association'|trans }}"
                 class="rounded-xl border border-teal-700 bg-teal-50/60 p-4 space-y-3">
                <h3 class="text-sm font-bold text-teal-900">{{ 'organisation.form.block_association'|trans }}</h3>

                <fieldset>
                    <legend class="text-sm font-semibold text-gray-900 mb-2">
                        {{ 'organisation.form.collaboration_interests'|trans }}
                    </legend>
                    <div class="space-y-2">
                        {% for choice in form.collaborationInterests %}
                            <label class="flex items-start gap-3 cursor-pointer">
                                {{ form_widget(choice, {'attr': {'class': 'mt-0.5 w-5 h-5 shrink-0 rounded border-gray-500 text-teal-700 focus:outline-2 focus:outline-offset-2 focus:outline-teal-700'}}) }}
                                <span class="text-sm text-gray-900">{{ choice.vars.label|trans }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    <p class="mt-3 text-xs text-teal-900">{{ 'organisation.form.association_no_money'|trans }}</p>
                </fieldset>
            </div>
        {% endif %}

        {{ include('partials/_form_field.html.twig', {
            field: form.message, rows: 4, autofocus: first_error_field == 'message'
        }) }}

        {# Honeypot – für Menschen und Screenreader unsichtbar. #}
        <div aria-hidden="true" class="absolute w-px h-px -left-[9999px] overflow-hidden">
            {{ form_label(form.companyWebsite) }}
            {{ form_widget(form.companyWebsite) }}
        </div>

        {# Einwilligung: unangehakt per Default. #}
        <div class="rounded-xl border border-gray-300 bg-gray-50 p-4 space-y-2">
            <div class="flex items-start gap-3">
                {{ form_widget(form.consent, {'attr': {
                    'class': 'mt-0.5 w-5 h-5 shrink-0 rounded border-gray-500 text-cyan-700 focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700',
                    'aria-describedby': form.consent.vars.id ~ '_error',
                    'aria-invalid': form.consent.vars.errors|length > 0 ? 'true' : false,
                }}) }}
                {{ form_label(form.consent, null, {'label_attr': {'class': 'text-sm text-gray-900 leading-relaxed cursor-pointer'}}) }}
            </div>

            <p id="{{ form.consent.vars.id }}_error" class="text-sm font-semibold text-red-700">
                {%- for error in form.consent.vars.errors %}{{ error.message }}{% endfor -%}
            </p>

            <p class="text-xs text-gray-700">
                {{ 'organisation.form.privacy_note'|trans }}
                <a href="{{ path('app_impressum') }}#datenschutz"
                   class="font-semibold text-cyan-800 underline rounded focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
                    {{ 'organisation.form.privacy_link'|trans }}
                </a>
            </p>
        </div>

        <button type="submit"
                class="w-full md:w-auto min-h-[48px] bg-cyan-700 hover:bg-cyan-800 text-white font-bold px-8 py-3 rounded-full shadow-md hover:shadow-lg motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700 cursor-pointer">
            {{ 'organisation.form.submit'|trans }}
        </button>

    {{ form_end(form) }}
</div>
