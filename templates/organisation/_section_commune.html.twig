{#
    Inhalt der Sektion „Gemeinden".

    Wird an zwei Stellen eingebunden: als Block auf der Übersichtsseite und als
    Hauptinhalt der eigenen Unterseite (/organisationen/{slug}). Deshalb steht
    hier kein <section>-Rahmen – Hintergrund und Abstände bestimmt die
    einbettende Seite.

    Die Überschriftenebene kommt von der einbettenden Seite (heading_level): Auf
    der eigenen Unterseite steht die Sektion direkt unter dem <h1> und braucht
    dort <h2>, sonst übersprünge die Seite eine Ebene.
#}
{% set hl = heading_level|default('h2') %}
    <{{ hl }} class="text-lg font-bold text-gray-900 mb-3">{{ 'organisation.commune.scope_title'|trans }}</{{ hl }}>
    <ul class="space-y-2 mb-8">
        {% for i in 1..4 %}
            <li class="flex items-start gap-3 text-gray-800">
                <span class="text-cyan-800 mt-0.5" aria-hidden="true">✓</span>
                <span>{{ ('organisation.commune.scope_' ~ i)|trans }}</span>
            </li>
        {% endfor %}
    </ul>

    <{{ hl }} class="text-lg font-bold text-gray-900 mb-3">{{ 'organisation.commune.deliverables_title'|trans }}</{{ hl }}>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        {% for i in 1..3 %}
            <div class="rounded-xl border border-gray-300 bg-white p-4">
                <p class="font-semibold text-gray-900 mb-1">{{ ('organisation.commune.deliverable_' ~ i ~ '_title')|trans }}</p>
                <p class="text-sm text-gray-700 leading-relaxed">{{ ('organisation.commune.deliverable_' ~ i ~ '_text')|trans }}</p>
            </div>
        {% endfor %}
    </div>

    <div class="rounded-xl border border-gray-300 bg-white p-5 mb-6">
        <{{ hl }} class="text-lg font-bold text-gray-900 mb-2">{{ 'organisation.commune.duration_title'|trans }}</{{ hl }}>
        <p class="text-gray-800 leading-relaxed">{{ 'organisation.commune.duration_text'|trans }}</p>
    </div>

    {# Kernaussage, deshalb hervorgehoben: bezahlt wird die Erhebung, nicht das Ergebnis. #}
    <div class="rounded-xl border-2 border-amber-600 bg-amber-50 p-5 mb-6">
        <{{ hl }} class="text-lg font-bold text-amber-900 mb-2">{{ 'organisation.commune.no_guarantee_title'|trans }}</{{ hl }}>
        <p class="text-amber-950 leading-relaxed">{{ 'organisation.commune.no_guarantee_text'|trans }}</p>
    </div>

    <div class="rounded-xl border border-gray-300 bg-white p-5 mb-6">
        <{{ hl }} class="text-lg font-bold text-gray-900 mb-2">{{ 'organisation.commune.law_title'|trans }}</{{ hl }}>
        <p class="text-gray-800 leading-relaxed mb-2">{{ 'organisation.commune.law_text'|trans }}</p>
        <p class="text-sm text-gray-700">{{ 'organisation.commune.law_disclaimer'|trans }}</p>
    </div>

    <p class="rounded-xl border-2 border-dashed border-cyan-700 bg-cyan-50 px-5 py-4 text-sm text-cyan-900 font-medium mb-6">
        {{ 'organisation.commune.pricing'|trans }}
    </p>

    <a href="#anfrage"
       class="inline-block min-h-[48px] bg-cyan-700 hover:bg-cyan-800 text-white font-bold px-8 py-3 rounded-full shadow-md hover:shadow-lg motion-safe:transition focus:outline-2 focus:outline-offset-2 focus:outline-cyan-700">
        {{ 'organisation.commune.cta'|trans }}
    </a>
