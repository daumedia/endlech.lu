# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
#DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> mobiliteit/opendata ###
MOBILITEIT_API_KEY=
###< mobiliteit/opendata ###

###> App-Warteliste (Feature 08) ###
# Öffentlicher TestFlight-Link der iOS-Beta. Leer = die Bestätigungsmail geht
# ohne Beta-Abschnitt hinaus; die Anmeldung läuft unverändert durch (AK-24).
# Der echte Wert gehört in .env.local bzw. in die Umgebung auf dem Server.
APP_TESTFLIGHT_URL=
###< App-Warteliste (Feature 08) ###

###> symfony/mailer ###
# Default: null (discard emails). Override in .env.local or .env.dev
# Dev (Mailpit): MAILER_DSN=smtp://localhost:1025
# Production (Brevo API): MAILER_DSN=brevo+api://YOUR_API_KEY@default
# Production (Brevo SMTP): MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default
MAILER_DSN=null://null
MAILER_SENDER_ADDRESS=noreply@endlech.lu
MAILER_SENDER_NAME=Endlech.lu

###> Interne Benachrichtigungen ###
# Empfänger der Team-Mail bei bestätigten Partner-Wartelisten-Anmeldungen.
CONTACT_EMAIL=info@endlech.lu
# Presseadresse auf /presse (Feature 05). ⚠ Das Postfach muss existieren und
# gelesen werden — siehe VB-02 in features/05-presse-kit/spec.md.
PRESS_EMAIL=support@endlech.lu
###< Interne Benachrichtigungen ###
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Platzhalter – KEIN Produktiv-Secret hier! In .env.local überschreiben und das
# Keypair mit derselben Passphrase generieren: php bin/console lexik:jwt:generate-keypair
JWT_PASSPHRASE=changeme
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> sentry/sentry-symfony ###
# Leer = Fehler-Tracking deaktiviert (greift ohnehin nur in prod, siehe config/packages/sentry.yaml).
# Der echte DSN gehört NICHT hierher – das Repo ist öffentlich. Auf Production in
# ~/public_html/.env.local eintragen, lokal bei Bedarf in .env.local.
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> Brevo · Marketing-Kontakte (Feature 04) ###
# Leer = Kontaktabgleich mit Brevo still aus (AK-47) – dasselbe Muster wie
# MOBILITEIT_API_KEY und SENTRY_DSN. Anmeldungen laufen dann unverändert durch, die
# Aufträge bleiben im Auftragsbuch stehen und gehen beim ersten Lauf mit gesetzten
# Werten hinaus. Die echten Werte gehören NICHT hierher – das Repo ist öffentlich.
# Auf Production in ~/public_html/.env.local eintragen, lokal bei Bedarf in .env.local.
#
# BREVO_API_KEY       Schlüssel für die Kontaktverwaltung (api-key-Header). Der Versand
#                     der Transaktionsmails hängt weiterhin am MAILER_DSN.
# BREVO_LIST_ID       Kennung der einen Marketing-Liste (Entscheidung 3: genau eine,
#                     segmentiert wird über Attribute). Leer = keine Listenzuordnung.
# BREVO_WEBHOOK_TOKEN Bearer-Geheimnis, gegen das POST /marketing/brevo/webhook prüft.
#                     Leer = der Webhook nimmt nichts an.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_WEBHOOK_TOKEN=
###< Brevo · Marketing-Kontakte (Feature 04) ###

# Absolute Basis-URL für Asset-Links der REST-API (Bilder, Avatare).
# Leer = Scheme+Host des aktuellen Requests. Hinter Proxy/CDN z. B. https://api.endlech.lu setzen.
APP_API_BASE_URL=''

# ⚠ BF-29 · `trusted_hosts` bleibt bewusst UNKONFIGURIERT.
#
# Zwei Versuche, es aus der Umgebung zu steuern, sind gescheitert und der Grund
# gehört festgehalten: `framework.trusted_hosts` erwartet eine Liste von Strings,
# und ein `%env(...)%`-Platzhalter kommt dort als EIN Eintrag an — der
# Container-Build bricht mit „Expected string, got array" ab. Symfonys
# `default:`-Prozessor hilft nicht: Er greift, wenn eine Variable FEHLT, nicht
# wenn sie leer ist.
#
# Der wirksame Schutz gegen einen gefälschten `Host:`-Header ist deshalb
# APP_API_BASE_URL (siehe unten): Ist es gesetzt, liest die API den Host gar
# nicht erst. `deploy.sh` warnt, wenn es auf Production fehlt.
#
# Wer `trusted_hosts` zusätzlich will, trägt die Liste FEST in
# config/packages/framework.yaml ein — nicht über eine Umgebungsvariable.

###> Absolute URLs der REST-API ###
# Leer = die API baut ihre Bild- und Avatar-URLs aus Schema und Host des Requests.
# Ein gefälschter `Host:`-Header steuert damit, was in der Antwort steht (QA B23,
# BF-29). Auf Produktion deshalb den echten Ursprung eintragen, z. B.
# APP_API_BASE_URL='https://endlech.lu' — dann nimmt AssetUrlBuilder den
# Request-Host gar nicht erst.
###< Absolute URLs der REST-API ###

###> web-auth/webauthn-symfony-bundle ###
# Die "relying party id" ist die nackte Domain, unter der Passkeys gelten:
# kein Schema, kein Port, kein Pfad, keine IP-Adresse. Sie gilt zugleich für
# alle Subdomains – umgekehrt nie. Deshalb auf Production endlech.lu und NICHT
# www.endlech.lu, sonst funktionieren die Passkeys auf der nackten Domain nicht.
#
# Auf dem Server in ~/public_html/.env.local setzen, und zwar VOR dem Merge nach
# production: Ein falscher Wert fällt erst beim ersten Anmeldeversuch auf.
WEBAUTHN_RP_ID=localhost
###< web-auth/webauthn-symfony-bundle ###

###> endlech deployment ###
# Reverse-Proxy vor der App (Coolify/Traefik, Cloudflare). Leer = keinem Proxy
# wird vertraut. Siehe framework.yaml -> trusted_proxies. Ohne Wert teilen sich
# hinter einem Proxy alle Besucher einen einzigen Rate-Limit-Deckel.
TRUSTED_PROXIES=
###< endlech deployment ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
