# Alles, was im Image nichts verloren hat oder dort neu entsteht.
# Kleinerer Build-Kontext = schnellere Builds und weniger Cache-Invalidierung.

# --- wird im Image selbst erzeugt ---
/vendor/
/node_modules/
/var/
/public/assets/
/public/bundles/
/assets/vendor/

# ⚠ /public/assets/ MUSS ignoriert werden: Der assets-Stage schreibt es neu, und
# COPY löscht nichts. Läge ein lokal kompilierter Stand mit im Kontext, blieben
# dessen Dateien mit alter Prüfsumme im Image liegen — und ein lokales
# manifest.json könnte den frisch gebauten Stand überdecken.
# /assets/vendor/ holt `importmap:install` frisch; ein lokaler Stand könnte
# eine andere Version tragen als importmap.php.

# --- Werkzeug und Metadaten ---
/.git/
/.github/
/.idea/
/.claude/
/.phpunit.cache/
/.editorconfig
/.nvmrc
/compose.yaml
/compose.override.yaml
/Makefile
/Dockerfile
/.dockerignore

# --- Geheimnisse: dürfen NIE ins Image ---
/.env.local
/.env.local.php
/.env.*.local
/config/jwt/*.pem
/config/secrets/

# --- Test- und Entwicklungsartefakte ---
/tests/
/phpunit.dist.xml
/phpunit.xml
/eslint.config.mjs
# Node dient nur noch Typprüfung und Lint — im Image baut nichts mehr mit npm.
/package.json
/package-lock.json
/tsconfig.json
# ⚠ .swcrc NICHT ignorieren – SWC liest sie im assets-Stage. Ohne sie übersetzt
# es nach ES5, und jeder Stimulus-Controller bricht im Browser ab („Class
# constructor Controller cannot be invoked without 'new'").
/bin/a11y-audit.mjs
/bin/generate-pwa-icons.sh

# --- Dokumentation und SDD-Artefakte (im Betrieb ungenutzt) ---
/docs/
/features/
/qa/
/CHANGELOG.md
/CLAUDE.md
/README.md
/LICENSE

# --- Nutzerdaten: gehören in ein Volume, nicht ins Image ---
/public/uploads/avatars/*
/public/uploads/restaurants/*
!/public/uploads/**/.gitkeep

# ⚠ /public/uploads/team/ bleibt drin — die Datei ist committet (Ausnahmeregel
# in .gitignore) und wird auf der Presseseite ausgeliefert.

# --- Sonstiges ---
**/.DS_Store
npm-debug.log
yarn-error.log
